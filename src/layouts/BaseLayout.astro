---
import { ViewTransitions } from 'astro:transitions';
import Header from '@/components/Header.astro';
import PageHeader from '@/components/PageHeader.astro';
import Footer from '@/components/Footer.astro';
import Lightbox from '@/components/Lightbox.astro';
import SectionRail from '@/components/SectionRail.astro';
import type { RailItem } from '@/lib/rail';
import '@/styles/page-transitions.css';

interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean;
  pageTitle?: string;
  pageTagline?: string;
  hideFooter?: boolean;
  backLink?: {
    href: string;
    label: string;
  };
  rail?: { heading?: string; items: RailItem[] };
  /** Opt out of the staggered content reveal — for full-screen takeover pages
      (e.g. the portfolio deck) that aren't a stack of document blocks and own
      their own entry animation. (Also avoids the reveal's lingering `transform`
      clobbering the page's own positioning transforms.) */
  noStagger?: boolean;
  /** When true, this page is unpublished work, gated behind preview mode:
      `noindex`, and an inline guard that redirects a normal (non-preview)
      visitor to `previewRedirect`. The `?preview=1` flag unlocks it. */
  previewGated?: boolean;
  /** Where the gate sends a non-preview visitor (usually the live product). */
  previewRedirect?: string;
}

const {
  title,
  description = 'René Galindo',
  hideHeader = false,
  pageTitle,
  pageTagline,
  hideFooter = false,
  backLink,
  rail,
  noStagger = false,
  previewGated = false,
  previewRedirect = '/work',
} = Astro.props;

const fullTitle = title === 'René Galindo' ? title : `${title} | René Galindo`;
// Absolute URL of this page, for the canonical link and og:url. `Astro.site`
// is the production origin set in astro.config; falls back to a relative path
// if it's ever unset so the build doesn't throw.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const showNavHeader = !hideHeader && !pageTitle;
const showPageHeader = !!pageTitle;
const contentTopPadding = showPageHeader
  ? 'pt-10'
  : showNavHeader
    ? 'pt-[112px] sm:pt-[120px]'
    : 'pt-4 sm:pt-6';
---

<!doctype html>
<html lang="en" class="scrollbar-gutter-stable">
  <head>
    <style is:global>
      .scrollbar-gutter-stable {
        scrollbar-gutter: stable;
      }
      /* Firefox */
      html {
        scrollbar-width: thin;
        scrollbar-color: #d1d5db transparent;
      }
      /* WebKit (Chrome, Safari, Edge) */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
      }
      /* GT America Font */
      @font-face {
        font-family: 'GT America';
        src: url('/fonts/GT-America-Standard-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'GT America';
        src: url('/fonts/GT-America-Standard-Medium.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      /* Minimal link style */
      main a {
        color: inherit;
        text-decoration: underline dotted;
        text-decoration-color: currentColor;
        text-underline-offset: 3px;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }
      main a:hover {
        color: #6b7280;
        text-decoration-color: #6b7280;
      }
      main a:active {
        color: #6b7280;
        text-decoration-color: #6b7280;
      }
      /* Shared expanded hit area for compact links and controls. */
      .hit-target {
        position: relative;
      }
      .hit-target::after {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        min-width: 44px;
        height: 44px;
        content: '';
        transform: translate(-50%, -50%);
      }
      /* Avoid background-clip at rest — it tints glyphs vs body text. */
      .rainbow-link {
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }
      .rainbow-link:hover,
      .rainbow-link:focus-visible {
        background-image: linear-gradient(90deg, hsl(345 98% 60%), hsl(38 100% 50%), hsl(160 95% 39%), hsl(200 100% 39%), hsl(263 84% 50%), hsl(345 98% 60%));
        background-size: 200% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        text-decoration-color: transparent;
        animation: rainbow-pan 3.5s linear infinite;
      }
      @keyframes rainbow-pan {
        to {
          background-position: 200% 50%;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .rainbow-link {
          transition: none;
        }
        .rainbow-link:hover,
        .rainbow-link:focus-visible {
          animation: none;
        }
      }
      /* Instant page transitions */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }
      /* Base font family */
      body {
        font-family: 'GT America', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }
      /* Staggered content reveal (top → bottom). The orchestration script tags
         the content blocks with .rise-item and a --rise-i index, then reveals
         `main`. We hide `main` until then (JS only) so nothing flashes at full
         opacity before the cascade starts. */
      html.js main {
        opacity: 0;
      }
      html.js main.rise-ready {
        opacity: 1;
      }
      @keyframes content-rise {
        from {
          opacity: 0;
          transform: translateY(4px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .rise-item {
        animation: content-rise 0.36s ease-out both;
        animation-delay: calc(var(--rise-i, 0) * 50ms);
      }
      @media (prefers-reduced-motion: reduce) {
        html.js main,
        html.js main.rise-ready {
          opacity: 1;
        }
        .rise-item {
          animation: none;
        }
      }
    </style>
    <script is:inline>
      // Marks JS as available before first paint so the reveal can hide `main`
      // immediately (no flash). No-JS falls back to fully visible content.
      document.documentElement.classList.add('js');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {/* OpenGraph + Twitter for link sharing. Text-only for now (no og:image);
        switch twitter:card to summary_large_image once share images exist. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="René Galindo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {/* Unpublished work: keep it out of search, and mark it for the preview
        script (which reads this meta on client-router navigations to re-run the
        gate — the inline guard below only fires on a hard load). */}
    {previewGated && <meta name="robots" content="noindex" />}
    {previewGated && <meta name="x-preview-gated" content={previewRedirect} />}
    {previewGated && (
      <script is:inline define:vars={{ to: previewRedirect }}>
        // Pre-paint gate for a hard load of an unpublished page: if preview mode
        // isn't on, bounce to the live product before any WIP content renders.
        // `?preview=1` turns preview on and remembers it for the session.
        (function () {
          try {
            var q = new URLSearchParams(location.search).get('preview');
            if (q === '1') sessionStorage.setItem('rg:preview', '1');
            if (q === '0') sessionStorage.removeItem('rg:preview');
            var on = q === '1' || sessionStorage.getItem('rg:preview') === '1';
            if (!on) location.replace(to);
          } catch (e) {}
        })();
      </script>
    )}
    <ViewTransitions />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <div class="min-h-screen flex flex-col">
      <Header hidden={!showNavHeader} />
      {showPageHeader && <PageHeader title={pageTitle!} tagline={pageTagline} backLink={backLink} />}
      <main data-no-stagger={noStagger ? '' : undefined} class:list={[
        "flex-1 w-full max-w-2xl mx-auto px-4 pb-24 text-[17px]",
        contentTopPadding,
      ]}>
        <slot />
      </main>
      {!hideFooter && (
        <Footer backLink={backLink} transition:persist />
      )}
    </div>

    {rail && <SectionRail heading={rail.heading} items={rail.items} />}

    {/* Preview-mode indicator. Hidden by default; the preview script reveals it
        whenever the session flag is on. Links out with `?preview=0`, which the
        gate clears — so this doubles as the exit. Persisted across client-router
        navigations so it stays put instead of flashing. */}
    <a
      id="preview-banner"
      href="/work?preview=0"
      hidden
      transition:persist
      class="fixed bottom-4 left-1/2 z-50 -translate-x-1/2 rounded-full bg-gray-900/90 px-3.5 py-1.5 text-sm text-white no-underline shadow-lg backdrop-blur transition-colors hover:bg-gray-900"
    >
      Preview mode
    </a>

    <Lightbox transition:persist />

    <script>
      // Preview mode gate. Runs on every load/navigation so the client router —
      // which doesn't re-run the inline head guard — stays gated and consistent.
      // The flag logic lives in @/lib/transitions (shared, testable); the inline
      // head guard is the one hand-rolled copy, since it must run pre-paint.
      import { previewActive } from '@/lib/transitions';

      function applyPreview() {
        const active = previewActive();

        // Gate an unpublished page reached via client-router nav (the inline
        // head guard only covers hard loads): bounce a non-preview visitor out.
        const gate = document.querySelector('meta[name="x-preview-gated"]');
        if (gate && !active) {
          window.location.replace(gate.getAttribute('content') || '/work');
          return;
        }

        // In preview mode, repoint unpublished cards from the live product to
        // their in-progress detail page (and drop the new-tab behavior).
        if (active) {
          document.querySelectorAll('[data-preview-href]').forEach((el) => {
            const to = el.getAttribute('data-preview-href');
            if (!to) return;
            el.setAttribute('href', to);
            el.removeAttribute('target');
            el.removeAttribute('rel');
          });
        }

        const banner = document.getElementById('preview-banner');
        if (banner) banner.toggleAttribute('hidden', !active);
      }

      document.addEventListener('astro:page-load', applyPreview);
    </script>

    <script>
      // Kick videos after every navigation. Resource selection only runs when
      // the browser *parses* the page (a full load or refresh); the client
      // router swaps the DOM in instead, so on an in-app navigation a video
      // arrives with its source unselected (networkState NO_SOURCE) and renders
      // blank until reload. This bites both modes: an autoplay clip never starts,
      // and a controls clip (preload="metadata") never fetches its first frame.
      // Forcing load() re-runs resource selection for any unloaded video; then we
      // additionally play() the autoplay ones (muted + playsInline keep that
      // inside the browser's autoplay policy, so play() isn't blocked). Controls
      // clips are user-driven, so we load() them but leave playback to the user.
      function kickVideos() {
        document.querySelectorAll('video').forEach((v) => {
          // Only reload when the swap left it unloaded — otherwise a normal
          // refresh (source already selected) would restart it from the top.
          if (v.networkState === v.NETWORK_NO_SOURCE || v.readyState === 0) {
            v.load();
          }
          if (v.autoplay) {
            const p = v.play();
            if (p) p.catch(() => {});
          }
        });
      }

      document.addEventListener('astro:page-load', kickVideos);
    </script>

    <script>
      import { consumeSuppressNextReveal } from '@/lib/transitions';

      // Reveal the main content blocks in a subtle top → bottom cascade on each
      // load/navigation.
      function runContentStagger() {
        const main = document.querySelector('main');
        if (!main) return;

        // The previous page (e.g. the portfolio deck, dropping away to reveal
        // this one) asked us to skip the reveal — so it reads as if this page
        // had been sitting there all along.
        if (consumeSuppressNextReveal()) {
          main.classList.add('rise-ready');
          return;
        }

        // Full-screen takeover pages opt out: reveal main without tagging its
        // children, so their positioning transforms aren't overridden.
        if (main.hasAttribute('data-no-stagger')) {
          main.classList.add('rise-ready');
          return;
        }

        // Pick the blocks to cascade. Pages either place several blocks
        // directly in <main>, or wrap them in a single container — in that one
        // case we step in once so we animate the real blocks, not the wrapper.
        // (Intentionally a single step, not a recursive descent, so the target
        // stays predictable if page markup changes.)
        const top = Array.from(main.children) as HTMLElement[];
        const blocks =
          top.length === 1 && top[0].children.length > 1
            ? (Array.from(top[0].children) as HTMLElement[])
            : top;

        // Cap the index so long pages don't crawl — later blocks share the last
        // delay and land together.
        const CAP = 6;
        blocks.forEach((el, i) => {
          el.style.setProperty('--rise-i', String(Math.min(i, CAP)));
          el.classList.add('rise-item');
        });

        main.classList.add('rise-ready');
      }

      document.addEventListener('astro:page-load', runContentStagger);

      // Tag the drawer-open transition when the launcher was scrolled at click
      // time, so its backdrop dissolves rather than pops (see
      // page-transitions.css). CSS can't read the outgoing page's scroll, so we
      // capture it here — before the swap, while still on the launcher — and
      // mark <html> after the swap, in time for the view-transition pseudo
      // styles to resolve. Registered once.
      //
      // Detect the deck by the presence of its `.deck` element, NOT by route:
      // the deck is a self-contained overlay that can mount under any path (see
      // Deck.astro's basePath/exitHref), and page-transitions.css already keys
      // its rules off `.deck` presence — so this tagging layer stays consistent
      // and host-agnostic. `astro:before-swap` exposes the incoming document.
      let deckFromScrolled = false;
      let deckIntra = false;
      document.addEventListener('astro:before-swap', (e) => {
        const toIsDeck = !!(e as { newDocument?: Document }).newDocument?.querySelector('.deck');
        const fromIsDeck = !!document.querySelector('.deck'); // pre-swap = outgoing page
        deckFromScrolled = toIsDeck && window.scrollY > 0;
        // Moving between two deck routes (browser back/forward across sections):
        // the drawer is already up and stays up — only the slide underneath
        // swaps. Tag it so page-transitions.css holds every drawer-motion
        // animation still, instead of replaying the open slide-up each time.
        deckIntra = fromIsDeck && toIsDeck;
      });
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.toggle('deck-from-scrolled', deckFromScrolled);
        document.documentElement.classList.toggle('deck-intra', deckIntra);
      });
    </script>
  </body>
</html>
