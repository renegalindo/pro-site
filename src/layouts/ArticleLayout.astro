---
// Long-form prose page (case study, blog post, etc.). Wraps BaseLayout in its
// page-title mode and renders slotted content inside a styled `.prose` article.
// Extracted from the former /work/[slug] route; currently has no consumer —
// kept as the template for a future blog / portfolio write-up route.
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** Heading shown in the page header; defaults to `title`. */
  pageTitle?: string;
  /** Tagline shown under the title in the page header. */
  pageTagline?: string;
  backLink?: { href: string; label: string };
  nextLink?: { href: string; label: string };
  hideFooter?: boolean;
}

const {
  title,
  description,
  pageTitle = title,
  pageTagline,
  backLink,
  nextLink,
  hideFooter = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  pageTitle={pageTitle}
  pageTagline={pageTagline}
  backLink={backLink}
  nextLink={nextLink}
  hideFooter={hideFooter}
>
  <article class="prose" data-escape-back={backLink?.href}>
    <slot />
  </article>
</BaseLayout>

<style>
  .prose {
    @apply text-gray-900 leading-relaxed;
  }

  /* Image break-out: text stays in the normal reading column, but any paragraph
     holding image(s) escapes it — capped wider than the text and centred on the
     page. Centring is done with margin (not transform) on purpose: the content
     reveal animates `transform`, which would otherwise clobber the centring. */
  .prose :global(p:has(> img)) {
    --breakout-w: min(64rem, 100vw - 2rem);
    width: var(--breakout-w);
    margin-left: calc(50% - var(--breakout-w) / 2);
  }

  .prose :global(h2) {
    @apply text-xl font-medium text-gray-900 mt-8 mb-4;
  }

  .prose :global(h3) {
    @apply text-lg font-medium text-gray-900 mt-6 mb-3;
  }

  .prose :global(p) {
    @apply mb-4;
  }

  .prose :global(ul) {
    @apply list-disc pl-6 mb-4;
  }

  .prose :global(li) {
    @apply mb-2;
  }

  .prose :global(a) {
    @apply underline hover:text-gray-600;
  }

  /* Images: centered, rounded, and height-capped so a tall phone screenshot
     doesn't run away vertically. `max-w-full` keeps wide images in the column. */
  .prose :global(img) {
    @apply block mx-auto my-16 max-h-[75vh] max-w-full w-auto rounded-2xl;
  }
  /* `data-zoomable` is added by the lightbox once it wires the image up, so the
     zoom cursor only shows when the image is actually interactive. */
  .prose :global(img[data-zoomable]) {
    cursor: zoom-in;
  }

  /* A single image centered in its own paragraph. */
  .prose :global(p:has(> img:only-child)) {
    @apply text-center;
  }

  /* Two or more images in one paragraph (consecutive `![](…)` lines with no
     blank line between them) lay out as an equal-width row that shares the
     column. Each image fills its track; heights differ naturally. */
  .prose :global(p:has(> img + img)) {
    @apply my-16 flex gap-3;
  }
  .prose :global(p:has(> img + img) > img) {
    @apply my-0 w-full min-w-0 flex-1;
  }
</style>

<script>
  // Escape returns to the article's back link, when one is set. Reads the href
  // off the article's data attribute so it isn't tied to any specific route.
  document.addEventListener('astro:page-load', () => {
    const article = document.querySelector<HTMLElement>('article.prose[data-escape-back]');
    const backHref = article?.dataset.escapeBack;
    if (!backHref) return;

    const controller = new AbortController();
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // Defer while a modal (e.g. the image lightbox) is open — there, Escape
      // dismisses the overlay rather than leaving the article.
      if (document.documentElement.hasAttribute('data-modal-open')) return;
      e.preventDefault();
      e.stopPropagation();
      window.location.href = backHref;
    }, { signal: controller.signal, capture: true });

    document.addEventListener('astro:before-preparation', () => controller.abort(), { once: true });
  });
</script>
