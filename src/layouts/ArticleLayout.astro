---
// Case-study page for /work/<slug>. Wraps BaseLayout in its page-title mode and
// renders the project's Markdown body (write-up + gallery) inside a styled
// `.prose` article, followed by a "role · year" meta line that CSS `order`
// lifts to sit between the write-up and the gallery (see the .meta rule).
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-astro';

interface Props {
  title: string;
  description?: string;
  /** Heading shown in the page header; defaults to `title`. */
  pageTitle?: string;
  /** Tagline shown under the title in the page header. */
  pageTagline?: string;
  /** Role shown left of the year on the meta line under the write-up. */
  role?: string;
  /** Year (or range) shown right of the role on the meta line. */
  year?: string;
  /** Live-product URL. When set, a CTA button opens it (new tab) from the meta
      line, sitting right of the role · year. Omit and no button renders. */
  externalUrl?: string;
  /** CTA label; defaults to `Visit <title>`. Set per project when the outbound
      destination isn't the product itself (e.g. a LinkedIn or video link). */
  ctaLabel?: string;
  backLink?: { href: string; label: string };
  hideFooter?: boolean;
  /** When true, this is an unpublished project page: gate it behind preview
      mode (noindex + redirect a normal visitor away). Forwarded to BaseLayout. */
  previewGated?: boolean;
  /** Where the gate sends a non-preview visitor (the live product). */
  previewRedirect?: string;
}

const {
  title,
  description,
  pageTitle = title,
  pageTagline,
  role,
  year,
  externalUrl,
  ctaLabel,
  backLink,
  hideFooter = false,
  previewGated = false,
  previewRedirect,
} = Astro.props;

// Role and year read as a single meta line: "Role · Year". Either may be absent.
const meta = [role, year].filter(Boolean).join(' · ');
const ctaText = ctaLabel ?? `Visit ${title}`;
---

<BaseLayout
  title={title}
  description={description}
  pageTitle={pageTitle}
  pageTagline={pageTagline}
  backLink={backLink}
  hideFooter={hideFooter}
  previewGated={previewGated}
  previewRedirect={previewRedirect}
>
  <article class="prose">
    <slot />
    {/* Rendered last, but CSS `order` lifts the whole row above the gallery
        (see .meta-row). Meta on the left, the live-product CTA on the right. */}
    {(meta || externalUrl) && (
      <div class="meta-row">
        {meta && <p class="meta">{meta}</p>}
        {externalUrl && (
          <a
            class="cta"
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ctaText}
            <ArrowUpRight size={16} aria-hidden="true" />
          </a>
        )}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  /* Flex column so the meta line — rendered last in source — can be lifted above
     the gallery with `order`: the write-up and meta keep the default order 0 and
     stay in source order, while media paragraphs get order 1 and drop to the
     bottom. The page is write-up-then-gallery: intro, byline, then the images. */
  .prose {
    @apply text-gray-900 leading-relaxed;
    display: flex;
    flex-direction: column;
  }

  /* Image / video break-out: text stays in the normal reading column, but any
     paragraph holding media escapes it — capped wider than the text and centred
     on the page. Centring uses margin (not transform) on purpose: the content
     reveal animates `transform`, which would otherwise clobber the centring.
     `order: 1` drops the whole gallery below the meta line. */
  .prose :global(p:has(> :is(img, video))) {
    order: 1;
    --breakout-w: min(64rem, 100vw - 2rem);
    width: var(--breakout-w);
    margin-left: calc(50% - var(--breakout-w) / 2);
  }

  .prose :global(h2) {
    @apply text-xl font-medium text-gray-900 mt-8 mb-4;
  }

  .prose :global(h3) {
    @apply text-lg font-medium text-gray-900 mt-6 mb-3;
  }

  .prose :global(p) {
    @apply mb-4;
  }

  /* The byline block — Role · Year, then the live-product CTA stacked below it,
     both left-aligned — sitting between the write-up and the gallery (placement
     via the flex `order` scheme above; order 0 keeps it above the order-1
     media). `gap-6` matches the write-up → byline spacing (last paragraph's
     `mb-4` + this row's `mt-2`), so the button sits an equal step below. */
  .prose .meta-row {
    @apply mt-2 flex flex-col items-start gap-6;
  }

  /* Role · Year. Same size as the body, toned down as metadata. */
  .prose .meta {
    @apply m-0 text-gray-500;
  }

  /* Live-product CTA. A small solid pill — the one deliberately prominent action
     on an otherwise muted page. Overrides the `.prose a` / `main a` link styles
     (underline, hover colour) that would otherwise apply. A 2px optical nudge
     (`-ml-0.5`) so the pill reads as flush with the text column above. */
  .prose .cta {
    @apply -ml-0.5 inline-flex items-center gap-1.5 rounded-full bg-gray-900 px-4 py-2 text-sm text-white no-underline transition-colors;
  }
  .prose .cta:hover {
    @apply bg-gray-700 text-white;
  }
  .prose .cta:focus-visible {
    @apply outline outline-2 outline-offset-2 outline-gray-400;
  }
  /* Nudge the arrow to sit a hair up so it reads as "outbound", not baseline. */
  .prose .cta :global(svg) {
    @apply -mt-px;
  }

  .prose :global(ul) {
    @apply list-disc pl-6 mb-4;
  }

  .prose :global(li) {
    @apply mb-2;
  }

  .prose :global(a) {
    @apply underline hover:text-gray-600;
  }

  /* Images and videos: centered and rounded. Width (and thus the 75vh height
     cap, container fit, and no-upscale) is set per element as an inline
     `width: min(…)` by the media rehype plugin, computed from the file's real
     dimensions so the box reserves its space before the file loads — no layout
     shift, which keeps scroll restoration intact on back/forward. `height: auto`
     lets that width drive height via the element's aspect ratio. */
  .prose :global(:is(img, video)) {
    @apply block mx-auto my-16 rounded-2xl;
    height: auto;
  }
  /* `data-zoomable` is added by the lightbox once it wires the image up, so the
     zoom cursor only shows when the image is actually interactive. */
  .prose :global(img[data-zoomable]) {
    cursor: zoom-in;
  }

  /* A single image or video centered in its own paragraph. */
  .prose :global(p:has(> :is(img, video):only-child)) {
    @apply text-center;
  }

  /* Two or more images in one paragraph (consecutive `![](…)` lines with no
     blank line between them) lay out as an equal-width row that shares the
     column. Each image fills its track; heights differ naturally. */
  .prose :global(p:has(> img + img)) {
    @apply my-16 flex gap-3;
  }
  .prose :global(p:has(> img + img) > img) {
    @apply my-0 w-full min-w-0 flex-1;
  }
</style>
