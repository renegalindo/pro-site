---
// Case-study page for /work/<slug>. Wraps BaseLayout in its page-title mode and
// renders the project's Markdown body (write-up + gallery) inside a styled
// `.prose` article, followed by a "role · year" meta line that CSS `order`
// lifts to sit between the write-up and the gallery (see the .meta rule).
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-astro';

interface Props {
  title: string;
  description?: string;
  /** Heading shown in the page header; defaults to `title`. */
  pageTitle?: string;
  /** Tagline shown under the title in the page header. */
  pageTagline?: string;
  /** Role shown left of the year on the meta line under the write-up. */
  role?: string;
  /** Year (or range) shown right of the role on the meta line. */
  year?: string;
  /** Live-product URL. When set, a CTA button opens it (new tab) from the meta
      line, sitting right of the role · year. Omit and no button renders. */
  externalUrl?: string;
  /** CTA label; defaults to `Visit <title>`. Set per project when the outbound
      destination isn't the product itself (e.g. a LinkedIn or video link). */
  ctaLabel?: string;
  backLink?: { href: string; label: string };
  /** Cycling prev/next project links, shown top-right. Both set or neither. */
  prevHref?: string;
  nextHref?: string;
  hideFooter?: boolean;
  /** When true, this is an unpublished project page: gate it behind preview
      mode (noindex + redirect a normal visitor away). Forwarded to BaseLayout. */
  previewGated?: boolean;
  /** Where the gate sends a non-preview visitor (the live product). */
  previewRedirect?: string;
}

const {
  title,
  description,
  pageTitle = title,
  pageTagline,
  role,
  year,
  externalUrl,
  ctaLabel,
  backLink,
  prevHref,
  nextHref,
  hideFooter = false,
  previewGated = false,
  previewRedirect,
} = Astro.props;

// Role and year read as a single meta line: "Role · Year". Either may be absent.
const meta = [role, year].filter(Boolean).join(' · ');
const ctaText = ctaLabel ?? 'Go to website';
---

<BaseLayout
  title={title}
  description={description}
  pageTitle={pageTitle}
  pageTagline={pageTagline}
  backLink={backLink}
  prevHref={prevHref}
  nextHref={nextHref}
  hideFooter={hideFooter}
  previewGated={previewGated}
  previewRedirect={previewRedirect}
>
  <article class="prose">
    <slot />
    {/* Rendered last, but CSS `order` lifts the whole row above the gallery
        (see .meta-row). Meta on the left, the live-product CTA on the right. */}
    {(meta || externalUrl) && (
      <div class="meta-row">
        {meta && <p class="meta">{meta}</p>}
        {externalUrl && (
          <a
            class="cta"
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {ctaText}
            <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
          </a>
        )}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  /* Flex column so the meta line — rendered last in source — can be lifted above
     the gallery with `order`: the write-up and meta keep the default order 0 and
     stay in source order, while media paragraphs get order 1 and drop to the
     bottom. The page is write-up-then-gallery: intro, byline, then the images. */
  .prose {
    @apply text-gray-900 leading-relaxed;
    display: flex;
    flex-direction: column;
  }

  /* Image / video break-out: text stays in the normal reading column, but any
     paragraph holding media escapes it — capped wider than the text and centred
     on the page. Centring uses margin (not transform) on purpose: the content
     reveal animates `transform`, which would otherwise clobber the centring.
     `order: 1` drops the whole gallery below the meta line. */
  .prose :global(p:has(> :is(img, video, iframe))),
  .prose :global(.before-after) {
    order: 1;
    --breakout-w: min(64rem, 100vw - 2rem);
    width: var(--breakout-w);
    margin-left: calc(50% - var(--breakout-w) / 2);
    /* Single source of truth for block-to-block vertical rhythm. Every media
       paragraph owns a top gap and no bottom gap, so — because .prose is a flex
       column (no margin collapse) — meta→media and media→media are always
       exactly this value. Change the gap here and nowhere else. The last block's
       bottom spacing comes from main's pb-24. */
    @apply mt-14 mb-0; /* 56px section gap */
  }

  .prose :global(h2) {
    @apply text-[1.375rem] font-medium text-gray-900 mt-8 mb-4;
  }

  .prose :global(h3) {
    @apply text-[1.1875rem] font-medium text-gray-900 mt-6 mb-3;
  }

  .prose :global(p) {
    @apply mb-4;
  }

  /* The byline row — Role · Year on the left, the live-product CTA aligned to
     the right on the same line — sitting between the write-up and the gallery
     (placement via the flex `order` scheme above; order 0 keeps it above the
     order-1 media). Wraps on narrow screens; `ml-auto` on the CTA keeps it
     right-aligned even when it drops to its own line. */
  .prose .meta-row {
    @apply mt-2 flex flex-wrap items-center gap-4;
  }

  /* Role · Year. Same size as the body, toned down as metadata. */
  .prose .meta {
    @apply m-0 text-base text-gray-500;
  }

  /* Live-product CTA. A small, quiet outline button — white fill, light-grey
     border — sitting right-aligned on the byline row (`ml-auto` pushes it to the
     far edge and keeps it there when the row wraps). Overrides the `.prose a` /
     `main a` link styles (underline, hover colour) that would otherwise apply. */
  .prose .cta {
    @apply ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-sm text-gray-900 no-underline transition duration-150 active:scale-[0.97] motion-reduce:active:scale-100;
  }
  .prose .cta:hover {
    @apply border-gray-300 bg-gray-50 text-gray-900;
  }
  .prose .cta:active {
    @apply bg-gray-100;
  }
  .prose .cta:focus-visible {
    @apply outline outline-2 outline-offset-2 outline-gray-400;
  }
  /* Nudge the arrow to sit a hair up so it reads as "outbound", not baseline. */
  .prose .cta :global(svg) {
    @apply -mt-px;
  }

  .prose :global(ul) {
    @apply list-disc pl-6 mb-4;
  }

  .prose :global(li) {
    @apply mb-2;
  }

  .prose :global(a) {
    @apply underline hover:text-gray-600;
  }

  /* Images and videos: centered and rounded. Width (and thus the 75vh height
     cap, container fit, and no-upscale) is set per element as an inline
     `width: min(…)` by the media rehype plugin, computed from the file's real
     dimensions so the box reserves its space before the file loads — no layout
     shift, which keeps scroll restoration intact on back/forward. `height: auto`
     lets that width drive height via the element's aspect ratio. */
  .prose :global(:is(img, video, iframe)) {
    @apply block mx-auto rounded-2xl;
    height: auto;
  }
  /* Separate light-backgrounded media (e.g. white screenshots) from the gray-50
     page. A hairline ring sits just outside the image edge, plus a whisper of
     shadow to lift it. The ring is translucent, so it's self-adaptive — all but
     invisible on dark or colourful images, just enough to catch the edge of a
     white one — which is why it can apply to every media block with no per-image
     tuning. Drawn with box-shadow (not border) so it never covers screenshot
     pixels and never changes the reserved layout box. The `.ba-img` exclusion
     keeps it off the before/after slider's stacked images (the slider frames
     itself). The lightbox paints its own matching ring on a separate element,
     so this never bleeds into the zoomed view. */
  .prose :global(:is(img, video, iframe):not(.ba-img)) {
    box-shadow:
      0 0 0 1px rgba(17, 24, 39, 0.05),
      0 1px 2px rgba(17, 24, 39, 0.04),
      0 10px 28px -14px rgba(17, 24, 39, 0.15);
  }
  /* YouTube embeds carry no intrinsic size — the border and the `aspect-ratio`
     (set inline by the media plugin) give them their box. */
  .prose :global(iframe) {
    @apply border-0;
  }
  /* `data-zoomable` is added by the lightbox once it wires the image up, so the
     zoom cursor only shows when the image is actually interactive. */
  .prose :global(img[data-zoomable]) {
    cursor: zoom-in;
  }

  /* A single image or video centered in its own paragraph. */
  .prose :global(p:has(> :is(img, video, iframe):only-child)) {
    @apply text-center;
  }

  /* Two or more images in one paragraph (consecutive `![](…)` lines with no
     blank line between them) lay out as an equal-width row that shares the
     column. Each image fills its track; heights differ naturally. */
  .prose :global(p:has(> img + img)) {
    @apply flex gap-3;
  }
  .prose :global(p:has(> img + img) > img) {
    @apply w-full min-w-0 flex-1;
  }
</style>
