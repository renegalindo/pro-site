---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { groupWork } from '@/lib/work';

const work = await getCollection('work');
const { client, company, personal } = groupWork(work);

const sections = [
  { label: 'Clients', items: client },
  { label: 'Companies', items: company },
  { label: 'Personal', items: personal },
].filter((section) => section.items.length > 0);

// A published project links in-tab to its /work/<slug> case study. A draft links
// straight out to the live product in a new tab, and carries `previewHref` so the
// preview script can swap the row to its in-progress detail page when preview is on.
const linkFor = (project) =>
  project.data.published
    ? { href: `/work/${project.slug}`, external: false }
    : { href: project.data.externalUrl, external: true, previewHref: `/work/${project.slug}` };
---

<BaseLayout title="Work" description="Design work by René Galindo" hideFooter>
  <div class="space-y-8">
    <div class="space-y-4 text-gray-900 leading-relaxed">
      <p>
        I've been designing the software I want to use since I bought my first iPhone in 2010. Along the way I've worked for different startups, mostly 0 to 1, moving between contributor and leadership roles.
      </p>
      <p>
        These days I design by building: the fastest way I know to find the right interface is to make the real one and use it until the solution is obvious.
      </p>
      <p>
        I obsess over simplicity and getting out of the way, which almost always means removing things until only the essentials are left. When it works, no one notices the design; they just get what they came for.
      </p>
    </div>

    {sections.map((section) => (
      <section>
        <h2 class="mt-8 mb-2 pb-1 text-base text-gray-500">{section.label}</h2>
        <ul class="flex flex-col gap-4 text-gray-900 sm:gap-2.5 sm:pr-4">
          {section.items.map((project) => (
            <ProjectCard
              title={project.data.name}
              year={project.data.year}
              logo={project.data.logo}
              {...linkFor(project)}
            />
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
