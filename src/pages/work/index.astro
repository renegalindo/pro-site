---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CurrentRoleCard from '@/components/CurrentRoleCard.astro';

const work = await getCollection('work');
const byOrder = (a, b) => a.data.order - b.data.order;

// The current role stands alone at the top as its own card (when `available`),
// and is kept out of the company history regardless — both keyed off the
// semantic `currentRole` flag rather than a hardcoded slug.
const currentRole = work.filter(p => p.data.currentRole && p.data.available).sort(byOrder);
const companies = work.filter(p => !p.data.sideProject && !p.data.currentRole).sort(byOrder);
const sideProjects = work.filter(p => p.data.sideProject).sort(byOrder);

const sections = [
  { label: 'Companies', items: companies },
  { label: 'Projects', items: sideProjects },
];
---

<BaseLayout title="Work" description="Design work by René Galindo" hideFooter>
  <div class="space-y-8">
    <div class="space-y-4 text-gray-700 leading-relaxed">
      <p>
        I've been designing the software I want to use since I bought my first iPhone in 2010. Along the way I've worked for different startups, mostly 0 to 1, moving between contributor and leadership roles.
      </p>
      <p>
        These days I mostly design by building: the fastest way I know to find the right interface is to make the real one and live in it until the solution is obvious.
      </p>
      <p>
        I obsess over simplicity and getting out of the way, which almost always means removing things until the essentials are left. When it works, no one notices the design; they just get what they came for.
      </p>
    </div>

    {currentRole.map((project) => (
      <CurrentRoleCard
        title={project.data.title}
        description={project.data.description}
        logo={project.data.logo}
      />
    ))}

    {sections.map((section) => (
      <section>
        <h2 class="mt-8 mb-2 pb-1 text-base text-gray-500">{section.label}</h2>
        <ul class="flex flex-col gap-4 text-gray-700 sm:gap-2.5">
          {section.items.map((project) => (
            <ProjectCard
              href={`/work/${project.slug}`}
              title={project.data.title}
              year={project.data.year}
              logo={project.data.logo}
            />
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
