---
// The deck, nested under /work as each project's detailed view:
//   /work/intro      → the intro section
//   /work/<slug>     → each project
// (/work itself is the overview page — work/index.astro.) Every route renders
// the whole deck (all sections in the DOM) and only differs in which section it
// boots on — so moving between projects is a client-side pushState, not a
// reload, and fullscreen survives the whole presentation.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Deck from '@/components/Deck.astro';
import { parsePortfolio } from '@/lib/portfolio';
import raw from '@/data/portfolio.md?raw';

export function getStaticPaths() {
  const projects = parsePortfolio(raw);
  return projects.map((p) => ({
    params: { project: p.slug },
    props: { slug: p.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const projects = parsePortfolio(raw);
const initialSection = Math.max(0, projects.findIndex((p) => p.slug === slug));
---

<BaseLayout title="Work" description="Selected work by René Galindo" hideHeader hideFooter noStagger>
  <Deck projects={projects} initialSection={initialSection} />
</BaseLayout>
