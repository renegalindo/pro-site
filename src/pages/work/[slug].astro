---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { orderedWork } from '@/lib/work';

export async function getStaticPaths() {
  // Only published projects get a page. Unpublished ones link straight out from
  // the list (see ProjectCard wiring in work/index.astro), so building a page
  // for them would expose in-progress work at a guessable URL.
  const work = await getCollection('work');
  const ordered = orderedWork(work.filter((p) => p.data.published));

  return ordered.map((project) => {
    return {
      params: { slug: project.slug },
      props: { project },
    };
  });
}

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<ArticleLayout
  title={project.data.title}
  description={project.data.description ?? project.data.title}
  role={project.data.role}
  year={project.data.year}
  backLink={{ href: '/work', label: 'Work' }}
  hideFooter
>
  <Content />
</ArticleLayout>
