---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SnapshotEntry from '@/components/SnapshotEntry.astro';
import { getNowSnapshots, snapshotRail, snapshotLabel } from '@/lib/snapshots';
import type { RailItem } from '@/lib/rail';

export async function getStaticPaths() {
  const snapshots = await getNowSnapshots();

  return snapshots.slice(1).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, rail: snapshotRail(snapshots, '/now', entry.slug) },
  }));
}

interface Props {
  entry: CollectionEntry<'now'>;
  rail: RailItem[];
}

const { entry, rail } = Astro.props;
const label = snapshotLabel(entry.data.date);
---

<BaseLayout
  title={`Now · ${label}`}
  description={`What René Galindo was up to in ${label}`}
  rail={{ heading: 'Time travel', items: rail }}
  hideFooter
>
  <SnapshotEntry entry={entry} />
</BaseLayout>
