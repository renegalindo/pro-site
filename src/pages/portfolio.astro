---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Slide from '@/components/Slide.astro';
import { parsePortfolio } from '@/lib/portfolio';
import raw from '@/data/portfolio.md?raw';

// The portfolio deck: one slide at a time, newest project first (file order is
// the presentation order). The nav on the right is a Notion-style table of
// contents of PROJECTS: bars at rest (the current project's is highlighted),
// expanding to a labeled list on hover. Clicking a project jumps to its first
// slide.
const projects = parsePortfolio(raw);

// First slide index of each project (a TOC click lands on the project's first
// slide).
const projectStarts: number[] = [];
let acc = 0;
for (const p of projects) {
  projectStarts.push(acc);
  acc += p.slides.length;
}

// Flatten to a single slide sequence; each slide knows its project so the TOC
// can highlight the current one.
const slides = projects.flatMap((p, pi) =>
  p.slides.map((slide) => ({ slide, projectIndex: pi }))
);
---

<BaseLayout title="Portfolio" description="Selected work by René Galindo" hideHeader hideFooter noStagger>
  <div class="deck" id="deck">
    <!-- Table of contents (projects), right — bars at rest, labels on hover -->
    <nav class="deck-toc deck-chrome" aria-label="Projects">
      <div class="deck-toc-bars" aria-hidden="true">
        {projects.map(() => <span class="deck-toc-bar"></span>)}
      </div>
      <ul class="deck-toc-list">
        {projects.map((p, i) => (
          <li>
            <button class="deck-toc-link" type="button" data-goto={projectStarts[i]}>{p.title}</button>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Slide stage -->
    <div class="deck-stage" data-stage>
      {slides.map((s, i) => (
        <section
          class:list={['deck-slide', i === 0 && 'is-active']}
          data-project={s.projectIndex}
        >
          <div class="deck-slide-inner">
            <Slide slide={s.slide} />
          </div>
        </section>
      ))}
    </div>

    <!-- Slide controls (bottom-center) -->
    <div class="deck-controls deck-chrome">
      <button class="deck-btn" type="button" data-prev aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <span class="deck-counter" data-counter>1 / {slides.length}</span>
      <button class="deck-btn" type="button" data-next aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <span class="deck-controls-sep" aria-hidden="true"></span>
      <button class="deck-btn" type="button" data-fullscreen aria-label="Toggle fullscreen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
      </button>
      <a class="deck-btn" href="/work" data-exit aria-label="Exit portfolio">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* The deck is a fixed full-viewport surface, so it escapes BaseLayout's
     constrained <main> and fills the screen. */
  .deck {
    position: fixed;
    inset: 0;
    background: #fafafa;
    color: #0a0a0a;
    z-index: 40;
  }

  /* --- Slide stage --- */
  .deck-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4.5rem 6rem 6rem;
  }

  .deck-slide {
    position: absolute;
    inset: 4.5rem 6rem 6rem;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }
  .deck-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .deck-slide-inner {
    width: 100%;
    max-width: 52rem;
    max-height: 100%;
    overflow-y: auto;
  }

  /* --- Slide controls, bottom-center --- */
  .deck-controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.15);
    z-index: 10;
  }
  .deck-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    color: #4b5563;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .deck-btn:hover {
    background: #f0f0f0;
    color: #0a0a0a;
  }
  .deck-btn:disabled {
    color: #d1d5db;
    cursor: default;
    background: none;
  }
  .deck-counter {
    font-size: 0.8125rem;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
    padding: 0 0.5rem;
    min-width: 3.5rem;
    text-align: center;
  }
  .deck-controls-sep {
    width: 1px;
    height: 1.25rem;
    background: #e5e7eb;
    margin: 0 0.25rem;
  }

  /* --- Table of contents (Notion-style: bars at rest, list on hover) --- */
  .deck-toc {
    position: absolute;
    top: 50%;
    right: 1.75rem;
    transform: translateY(-50%);
    z-index: 10;
  }
  /* Resting bars — one per project, right-aligned. */
  .deck-toc-bars {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    transition: opacity 0.15s ease;
  }
  .deck-toc-bar {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: #d1d5db;
    transition: width 0.16s ease, background 0.16s ease;
  }
  .deck-toc-bar.is-active {
    width: 24px;
    background: #0a0a0a;
  }
  /* Hover panel — the labeled list, anchored to the same right edge. */
  .deck-toc-list {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    min-width: 11rem;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    padding: 0.5rem;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 0.625rem;
    /* Shared popover-card elevation (matches SectionRail .rail-card and
       ContactMenu .contact-card) so floating surfaces read as one system. */
    box-shadow: 0 0 0 1px rgb(10 10 10 / 0.05), 0 8px 24px -6px rgb(0 0 0 / 0.12), 0 2px 6px -2px rgb(0 0 0 / 0.05);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .deck-toc:hover .deck-toc-bars {
    opacity: 0;
  }
  .deck-toc:hover .deck-toc-list {
    opacity: 1;
    pointer-events: auto;
  }
  .deck-toc-link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: #6b7280;
    white-space: nowrap;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .deck-toc-link:hover {
    background: #f5f5f5;
    color: #0a0a0a;
  }
  .deck-toc-link.is-active {
    color: #0a0a0a;
    font-weight: 500;
  }

  /* --- Presentation focus (fullscreen only) --- */
  /* While presenting in fullscreen, arrow navigation softly hides the chrome
     (rail + controls); any mouse move brings it back. Windowed, this class is
     never applied, so everything stays visible. The cursor is never hidden. */
  .deck-chrome {
    transition: opacity 0.45s ease;
  }
  .deck.is-focused .deck-chrome {
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .deck-chrome {
      transition: none;
    }
  }

  @media (max-width: 639.98px) {
    .deck-stage,
    .deck-slide {
      inset: 4rem 1.25rem 5rem;
      padding: 0;
    }
    .deck-toc { right: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-slide { transition: none; }
  }
</style>

<script>
  function initDeck() {
    const deck = document.getElementById('deck');
    if (!deck) return;

    const slides = Array.from(deck.querySelectorAll<HTMLElement>('.deck-slide'));
    const tocBars = Array.from(deck.querySelectorAll<HTMLElement>('.deck-toc-bar'));
    const tocLinks = Array.from(deck.querySelectorAll<HTMLElement>('.deck-toc-link'));
    const counter = deck.querySelector<HTMLElement>('[data-counter]');
    const prevBtn = deck.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = deck.querySelector<HTMLButtonElement>('[data-next]');
    const fsBtn = deck.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const exitLink = deck.querySelector<HTMLAnchorElement>('[data-exit]');
    if (!slides.length) return;

    // One controller tears down every listener together on navigation away
    // (the AbortController convention used across the site — see SectionRail,
    // ContactMenu, headerScroll).
    const controller = new AbortController();
    const { signal } = controller;

    const total = slides.length;
    let index = 0;

    function show(next: number) {
      index = Math.max(0, Math.min(total - 1, next));

      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));

      // Highlight the current project in the table of contents.
      const project = Number(slides[index].dataset.project);
      tocBars.forEach((b, i) => b.classList.toggle('is-active', i === project));
      tocLinks.forEach((l, i) => l.classList.toggle('is-active', i === project));

      if (counter) counter.textContent = `${index + 1} / ${total}`;
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === total - 1;

      history.replaceState(null, '', `#s${index + 1}`);
    }

    // --- Navigation ---
    prevBtn?.addEventListener('click', () => show(index - 1), { signal });
    nextBtn?.addEventListener('click', () => show(index + 1), { signal });

    // --- TOC navigation (click a project → its first slide) ---
    tocLinks.forEach((l) => l.addEventListener('click', () => show(Number(l.dataset.goto)), { signal }));

    // --- Presentation focus (fullscreen only) ---
    // Hiding the chrome is reserved for actual fullscreen presenting. Windowed,
    // everything stays visible — no timers, no auto-hide, no cursor hiding.
    const hideChrome = () => deck.classList.add('is-focused');
    const showChrome = () => deck.classList.remove('is-focused');

    // Any pointer movement brings the chrome back (and it stays until the next
    // arrow press). Guarded so it touches the DOM only when chrome is hidden.
    deck.addEventListener('mousemove', () => {
      if (deck.classList.contains('is-focused')) showChrome();
    }, { signal });

    // Leaving fullscreen always restores the chrome.
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) showChrome();
    }, { signal });

    // In fullscreen, arrow navigation hides the chrome; windowed, it does not.
    const focusOnNav = () => { if (document.fullscreenElement) hideChrome(); };

    // --- Keyboard ---
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
        e.preventDefault();
        show(index + 1);
        focusOnNav();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        show(index - 1);
        focusOnNav();
      } else if (e.key === 'Escape') {
        // Back out one level: leave fullscreen, else exit the deck (→ /work).
        if (document.fullscreenElement) document.exitFullscreen();
        else window.location.href = exitLink?.getAttribute('href') ?? '/work';
      }
    }, { signal });

    // --- Click stage to advance (ignoring media, links, buttons) ---
    deck.querySelector('[data-stage]')?.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a, button, figure, iframe, video')) return;
      show(index + 1);
    }, { signal });

    // --- Swipe ---
    let startX = 0;
    deck.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true, signal });
    deck.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true, signal });

    // --- Fullscreen (present mode for interviews) ---
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else deck.requestFullscreen?.();
    }, { signal });

    // --- Deep link: #s3 restores slide 3 on load/share ---
    const fromHash = Number(location.hash.match(/^#s(\d+)$/)?.[1]);
    show(Number.isFinite(fromHash) && fromHash > 0 ? fromHash - 1 : 0);

    // Tear every listener down together on navigation away.
    document.addEventListener('astro:before-preparation', () => controller.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initDeck);
</script>
