---
// Launcher for the slide-deck prototype (see src/components/Deck.astro). This
// is the page the deck drawer rises over and drops back to — every link here
// opens the deck at a section via the client router, so it arrives with the
// drawer transition. Kept intact after work moved to its own pages, so the deck
// pattern stays runnable and reusable.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { parsePortfolio } from '@/lib/portfolio';
import raw from '@/data/portfolio.md?raw';

const projects = parsePortfolio(raw);
const intro = projects.find((p) => p.slug === 'intro');
const rest = projects.filter((p) => p.slug !== 'intro');
---

<BaseLayout title="Deck" description="Slide-deck prototype" hideFooter>
  <div class="space-y-8">
    <div class="space-y-4 text-gray-700 leading-relaxed">
      <p>
        A one-slide-at-a-time presentation prototype — a drawer that rises over
        the page, steps through media with arrow keys, and presents fullscreen.
        Built for a portfolio review; kept here as a reusable pattern.
      </p>
      {intro && (
        <p>
          <a href={`/deck/${intro.slug}`} class="font-medium">Open the deck →</a>
        </p>
      )}
    </div>

    <section>
      <h2 class="mt-8 mb-2 pb-1 text-base text-gray-500">Sections</h2>
      <ul class="flex flex-col gap-4 text-gray-700 sm:gap-2.5 sm:pr-4">
        {rest.map((p) => (
          // Internal link (external defaults false) → the client router runs the
          // drawer-open transition into the deck.
          <ProjectCard title={p.title} logo={p.logo} href={`/deck/${p.slug}`} />
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
