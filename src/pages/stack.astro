---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppIconLabel from '@/components/AppIconLabel.astro';

const sections = [
  {
    title: 'Design / Code',
    items: [
      {
        name: 'Claude',
        description: 'Workhorse of choice for building anything',
        href: 'https://www.anthropic.com/product/claude-code',
        icon: '/app-icons/claude-code.jpg',
      },
      {
        name: 'Paseo',
        description: 'Daily driver for coding agents',
        href: 'https://paseo.sh/',
        icon: '/app-icons/paseo.svg',
      },
      {
        name: 'Cursor',
        description: 'Frontend details and manual tweaks',
        href: 'https://cursor.com/',
        icon: '/app-icons/cursor.png',
      },
      {
        name: 'Figma',
        description: 'Disposable UI explorations',
        href: 'https://www.figma.com/',
        icon: '/app-icons/figma.png',
      },
      {
        name: 'Balsamiq',
        description: 'Low-fidelity wireframes (guilty pleasure)',
        href: 'https://balsamiq.com/',
        icon: '/app-icons/balsamiq.png',
      },
    ],
  },
  {
    title: 'Productivity',
    items: [
      {
        name: 'Blank Page',
        description: 'Where every first draft starts',
        href: 'https://blank.page/',
        icon: '/app-icons/blank-page.svg',
      },
      {
        name: 'Fantastical',
        description: 'Calendar and scheduling, everywhere I go',
        href: 'https://flexibits.com/fantastical',
        icon: '/app-icons/fantastical.jpg',
      },
      {
        name: 'Notion',
        description: 'Mostly databases and kanban boards',
        href: 'https://www.notion.com/product',
        icon: '/app-icons/notion.png',
      },
      {
        name: 'Raycast',
        description: 'Emoji picker that also launches apps',
        href: 'https://www.raycast.com/',
        icon: '/app-icons/raycast.png',
      },
      {
        name: 'Simplify',
        description: 'Makes Gmail surprisingly clean',
        href: 'https://simpl.fyi/',
        icon: '/app-icons/simplify-gmail.png',
      },
      {
        name: 'Supercut',
        description: 'Recording bugs and quick demos',
        href: 'https://supercut.ai/',
        icon: '/app-icons/supercut.png',
      },
      {
        name: 'Superwhisper',
        description: 'Dictation, faster than typing',
        href: 'https://superwhisper.com/',
        icon: '/app-icons/superwhisper.png',
      },
      {
        name: 'Things',
        description: 'Timeless task management',
        href: 'https://culturedcode.com/things/',
        icon: '/app-icons/things.jpg',
      },
    ],
  },
];
---

<BaseLayout
  title="Stack"
  description="Tools and software I use"
  hideFooter
>
  <div class="space-y-8">
    <p class="text-gray-700">
      Inspired by Brian Lovin's <a
        href="https://brianlovin.com/stack"
        target="_blank"
        rel="noopener noreferrer"
      >stack</a>, here's my shortlist of the apps I use daily:
    </p>

    {sections.map((section) => (
      <section>
        <h2 class="mt-8 mb-2 pb-1 text-base text-gray-500">
          {section.title}
        </h2>
        <ul class="flex flex-col gap-4 text-gray-700 sm:gap-2.5">
          {section.items.map((item) => (
            <li class="relative pl-7 sm:flex sm:items-baseline">
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group block w-fit rounded-sm no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300 sm:w-28 sm:shrink-0"
              >
                <AppIconLabel icon={item.icon} label={item.name} />
              </a>
              <span class="block text-gray-700 sm:ml-8">{item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
