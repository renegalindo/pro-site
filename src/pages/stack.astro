---
import BaseLayout from '@/layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Design / Code',
    items: [
      {
        name: 'Claude Code',
        description: 'Workhorse of choice for building anything',
        href: 'https://www.anthropic.com/product/claude-code',
        icon: '/app-icons/claude-code.jpg',
      },
      {
        name: 'Paseo',
        description: 'Daily driver for coding agents',
        href: 'https://paseo.sh/',
        icon: '/app-icons/paseo.svg',
      },
      {
        name: 'Cursor',
        description: 'Frontend details and manual tweaks',
        href: 'https://cursor.com/',
        icon: '/app-icons/cursor.png',
      },
      {
        name: 'Figma',
        description: 'Disposable UI explorations',
        href: 'https://www.figma.com/',
        icon: '/app-icons/figma.png',
      },
      {
        name: 'Balsamiq',
        description: 'Super low-fidelity wireframe (guilty pleasure)',
        href: 'https://balsamiq.com/',
        icon: '/app-icons/balsamiq.png',
      },
    ],
  },
  {
    title: 'Productivity',
    items: [
      {
        name: 'Blank Page',
        description: 'The simplest way to write online',
        href: 'https://blank.page/',
        icon: '/app-icons/blank-page.png',
      },
      {
        name: 'Fantastical',
        description: 'Beautiful calendar and scheduling',
        href: 'https://flexibits.com/fantastical',
        icon: '/app-icons/fantastical.jpg',
      },
      {
        name: 'Notion',
        description: 'Notes, docs',
        href: 'https://www.notion.com/product',
        icon: '/app-icons/notion.png',
      },
      {
        name: 'Raycast',
        description: 'Launcher',
        href: 'https://www.raycast.com/',
        icon: '/app-icons/raycast.png',
      },
      {
        name: 'Simplify',
        description: 'A cleaner Gmail experience',
        href: 'https://simpl.fyi/',
        icon: '/app-icons/simplify-gmail.png',
      },
      {
        name: 'Supercut',
        description: 'Video messaging for async work',
        href: 'https://supercut.ai/',
        icon: '/app-icons/supercut.png',
      },
      {
        name: 'Things',
        description: 'Task management',
        href: 'https://culturedcode.com/things/',
        icon: '/app-icons/things.jpg',
      },
    ],
  },
];
---

<BaseLayout
  title="Stack"
  description="Tools and software I use"
  footerText="Updated: July 16, 2026"
>
  <div class="space-y-8">
    <p class="text-gray-700">
      Inspired by Brian Lovin's <a href="https://brianlovin.com/stack">stack</a>, here's my shortlist of the apps I use daily.
    </p>

    {sections.map((section) => (
      <section>
        <h2 class="mt-8 mb-2 text-gray-500 text-base pb-1">{section.title}</h2>
        <ul class="space-y-[10px] text-gray-700">
          {section.items.map((item) => (
            <li class="flex items-start">
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 no-underline"
              >
                <img
                  src={item.icon}
                  alt=""
                  width="24"
                  height="24"
                  class="h-6 w-6 shrink-0 rounded-md transition-shadow duration-150 ease-out group-hover:shadow-[0_2px_6px_rgba(17,24,39,0.14)]"
                  decoding="async"
                  loading="lazy"
                />
                <span class="font-medium text-gray-900 transition-colors group-hover:text-gray-600">
                  {item.name}
                </span>
              </a>
              <span class="ml-1 min-w-0 text-gray-700">{item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
