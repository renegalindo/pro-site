---
import BaseLayout from '@/layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Design / Code',
    items: [
      {
        name: 'Claude',
        description: 'Workhorse of choice for building anything',
        href: 'https://www.anthropic.com/product/claude-code',
        icon: '/app-icons/claude-code.jpg',
      },
      {
        name: 'Paseo',
        description: 'Daily driver for coding agents',
        href: 'https://paseo.sh/',
        icon: '/app-icons/paseo.svg',
      },
      {
        name: 'Cursor',
        description: 'Frontend details and manual tweaks',
        href: 'https://cursor.com/',
        icon: '/app-icons/cursor.png',
      },
      {
        name: 'Figma',
        description: 'Disposable UI explorations',
        href: 'https://www.figma.com/',
        icon: '/app-icons/figma.png',
      },
      {
        name: 'Balsamiq',
        description: 'Low-fidelity wireframes (guilty pleasure)',
        href: 'https://balsamiq.com/',
        icon: '/app-icons/balsamiq.png',
      },
    ],
  },
  {
    title: 'Productivity',
    items: [
      {
        name: 'Blank Page',
        description: 'Where every first draft starts',
        href: 'https://blank.page/',
        icon: '/app-icons/blank-page.png',
      },
      {
        name: 'Fantastical',
        description: 'Calendar and scheduling, everywhere',
        href: 'https://flexibits.com/fantastical',
        icon: '/app-icons/fantastical.jpg',
      },
      {
        name: 'Notion',
        description: 'Mostly databases and kanban boards',
        href: 'https://www.notion.com/product',
        icon: '/app-icons/notion.png',
      },
      {
        name: 'Raycast',
        description: 'Emoji picker that also launches apps',
        href: 'https://www.raycast.com/',
        icon: '/app-icons/raycast.png',
      },
      {
        name: 'Simplify',
        description: 'Makes Gmail surprisingly clean',
        href: 'https://simpl.fyi/',
        icon: '/app-icons/simplify-gmail.png',
      },
      {
        name: 'Supercut',
        description: 'Recording bugs and quick demos',
        href: 'https://supercut.ai/',
        icon: '/app-icons/supercut.png',
      },
      {
        name: 'Things',
        description: 'Timeless task management',
        href: 'https://culturedcode.com/things/',
        icon: '/app-icons/things.jpg',
      },
    ],
  },
];
---

<BaseLayout
  title="Stack"
  description="Tools and software I use"
  footerText="Updated: July 2026"
>
  <div class="space-y-8">
    <p class="text-gray-700">
      Inspired by Brian Lovin's <a href="https://brianlovin.com/stack">stack</a>, here's my shortlist of the apps I use daily:
    </p>

    {sections.map((section) => (
      <section>
        <h2 class="mt-8 mb-2 text-gray-500 text-base pb-1">{section.title}</h2>
        <ul class="space-y-3 text-gray-700 sm:space-y-2">
          {section.items.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-2 no-underline"
              >
                <img
                  src={item.icon}
                  alt=""
                  width="20"
                  height="20"
                  class="mt-0.5 h-5 w-5 shrink-0 rounded shadow-[0_0_0_1px_rgba(17,24,39,0.05),0_1px_1px_rgba(17,24,39,0.05)] transition-shadow duration-150 ease-out group-hover:shadow-[0_0_0_1px_rgba(17,24,39,0.05),0_3px_8px_rgba(17,24,39,0.22)]"
                  decoding="async"
                  loading="lazy"
                />
                <span class="flex min-w-0 flex-col items-start sm:flex-row sm:items-baseline sm:gap-2.5">
                  <span class="whitespace-nowrap font-medium text-gray-900 transition-colors group-hover:text-gray-600">
                    {item.name}
                  </span>
                  <span class="text-gray-700">{item.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
