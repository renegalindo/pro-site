---
// Renders one portfolio slide: media that scales to fill the stage, with an
// optional caption beneath it.
//
// This is currently the deck's ONLY layout — "media + caption". The content
// model (src/lib/portfolio.ts) still parses heading/subheading/description, but
// nothing renders them yet; the other layouts (text beside/above media,
// text-only) will be added back here as they're needed.
//
// Images carry their URL in `data-src`, not `src`: the deck loads them a section
// at a time (current ± 1) and swaps in the real src once in view — so a long
// deck never fetches more than a few images ahead. See Deck.astro's
// loadSection().
import type { Slide } from '@/lib/portfolio';

interface Props {
  slide: Slide;
}

const { slide } = Astro.props;
const { media, caption } = slide;
---

<div class="slide">
  {media && (
    <figure class="slide-media">
      <div class="slide-frame">
        {media.type === 'image' && (
          <img data-src={media.src} alt={media.alt} loading="lazy" data-media-img />
        )}
        {media.type === 'video' && (
          <video
            src={media.src}
            autoplay
            muted
            loop
            playsinline
            class="slide-asset"
          />
        )}
        {media.type === 'youtube' && (
          <iframe
            class="slide-asset"
            src={`https://www.youtube.com/embed/${media.src}`}
            title={media.alt}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        )}
      </div>
      {caption && <figcaption class="slide-caption">{caption}</figcaption>}
    </figure>
  )}
</div>

<style>
  /* The media scales to fill the stage — bounded by BOTH width and height so it
     never overflows or distorts — and stays centered. `min-height: 0` lets the
     flex children shrink below their intrinsic size so tall media doesn't
     overflow. `--media-max-h` reserves the stage's vertical chrome (deck top
     inset 2rem + stage top 3.5rem + stage bottom 6.5rem + caption ~2rem); keep
     it in sync with the .deck-stage / .deck-slide insets in Deck.astro. */
  .slide {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    /* Subtrahend = vertical chrome (deck 2rem + stage 3.5 + 6.5 = 12rem) plus a
       caption reserve. Reserve ~5rem so a caption that wraps to 2–3 lines under
       narrow/portrait media still fits without clipping. */
    --media-max-h: calc(100vh - 17rem);
  }

  .slide-media {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 0;
    /* Shrink-wrap the figure to the media and center it, so the caption below
       aligns to the media's left edge rather than centering. */
    align-self: center;
    width: fit-content;
    max-width: 100%;
  }

  .slide-frame {
    display: flex;
    min-height: 0;
    max-width: 100%;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    background: #f5f5f5;
  }

  .slide-frame :is(img, .slide-asset) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--media-max-h);
  }

  .slide-caption {
    font-size: 0.875rem;
    color: #6b7280;
    /* Wrap to the media's width instead of driving the figure wider than the
       media (which would stretch the frame — visible with narrow/portrait media
       + a long caption). `width: 0` drops the caption from the figure's
       shrink-to-fit width calc; `min-width: 100%` then matches the media. */
    width: 0;
    min-width: 100%;
  }
</style>
