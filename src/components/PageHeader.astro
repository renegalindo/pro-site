---
import { ArrowLeft, ArrowUp, ArrowDown } from 'lucide-astro';

interface Props {
  title: string;
  tagline?: string;
  /** Optional "up one level" link shown as a small eyebrow above the title. */
  backLink?: { href: string; label: string };
  /** Cycling prev/next project links, shown as a stacked pair top-right. */
  prevHref?: string;
  nextHref?: string;
}

const { title, tagline, backLink, prevHref, nextHref } = Astro.props;

// Shared classes for the fixed chrome buttons (back, prev, next), so all three
// read as one family. The back link adds its own layout classes on top.
const chipClass =
  'inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-900 no-underline transition duration-150 hover:border-gray-300 hover:bg-gray-50 active:scale-[0.97] active:bg-gray-100 motion-reduce:active:scale-100';

// Prev/next arrows render from one template — Up = previous, Down = next.
const cycleLinks = [
  prevHref && { href: prevHref, label: 'Previous', Icon: ArrowUp },
  nextHref && { href: nextHref, label: 'Next', Icon: ArrowDown },
].filter(Boolean) as { href: string; label: string; Icon: typeof ArrowUp }[];
---

<header class="w-full">
  {/* Fixed chrome bar — an (invisible) header row spanning the top: back chip on
      the left, cycling prev/next arrows inline on the right. The bar itself is
      `pointer-events-none` so its empty middle never swallows clicks/selection
      over the content; only the actual controls opt back in with
      `pointer-events-auto`. */}
  {(backLink || prevHref || nextHref) && (
    <Fragment>
      {/* Scrim behind the bar — mobile only (`sm:hidden`). On a phone the content
          column is full-width, so scrolled body text would otherwise pass behind
          the transparent controls and collide with them; on desktop they sit out
          in the wide margins, clear of the centred text, so no scrim is needed. A
          soft top-down fade (iOS large-title style) dissolves content under the
          bar. `pointer-events-none` so it never swallows a tap. */}
      <div
        aria-hidden="true"
        class="pointer-events-none fixed inset-x-0 top-0 z-30 h-20 bg-gradient-to-b from-gray-50 from-40% to-transparent sm:hidden"
      />
      <div class="pointer-events-none fixed inset-x-0 top-0 z-40 flex items-center justify-between px-3.5 py-3.5 sm:px-5 sm:py-5">
        {backLink ? (
          <a
            href={backLink.href}
            class:list={['hit-target pointer-events-auto gap-1.5 px-2.5 py-1 text-sm', chipClass]}
          >
            <ArrowLeft size={16} stroke-width={1.5} />
            {backLink.label}
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {/* Up = previous, Down = next; the pair wraps at the list ends (see
            [slug].astro). Tooltips drop below so they don't clip the top edge. */}
        {cycleLinks.length > 0 && (
          <nav aria-label="Project navigation" class="pointer-events-auto flex items-center gap-1">
            {cycleLinks.map(({ href, label, Icon }) => (
              <a href={href} aria-label={`${label} project`} class:list={['hit-target group relative p-1.5', chipClass]}>
                <Icon size={16} stroke-width={1.5} />
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute left-1/2 top-full mt-2 -translate-x-1/2 whitespace-nowrap rounded-md bg-gray-900 px-2 py-1 text-xs text-white opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-hover:delay-150"
                >
                  {label}
                </span>
              </a>
            ))}
          </nav>
        )}
      </div>
    </Fragment>
  )}
  <div class="max-w-2xl mx-auto px-4 pt-24 sm:pt-32">
    <h1 class="text-[2.75rem] font-medium leading-[1.1] tracking-tight text-gray-900">{title}</h1>
    {tagline && (
      <p class="mt-2 text-[1.375rem] text-gray-900">{tagline}</p>
    )}
  </div>
</header>
