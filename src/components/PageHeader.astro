---
interface Props {
  title: string;
  tagline?: string;
}

const { title, tagline } = Astro.props;
---

<header class="w-full">
  <div class="max-w-2xl mx-auto px-4 pt-24 sm:pt-32">
    <h1 class="text-[2.75rem] font-medium leading-[1.1] tracking-tight text-gray-900">{title}</h1>
    {tagline && (
      <p class="mt-2 text-xl text-gray-900">{tagline}</p>
    )}
  </div>
</header>
