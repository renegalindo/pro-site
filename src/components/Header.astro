          <path fill-rule="evenodd" clip-rule="evenodd" d="M78.822 154.776C72.6077 158.674 72.6077 158.674 65.4646 160.243C58.6863 161.781 51.9745 160.265 48.414 156.467C44.7318 152.58 43.4934 145.85 44.7097 136.463C45.1852 132.851 42.6198 129.547 38.9819 129.086C35.3662 128.482 32.0379 131.15 31.5624 134.773C29.7932 148.233 32.2037 158.575 38.7166 165.48C43.9136 170.992 51.7533 174 60.2454 174C62.9103 174 65.6304 173.715 68.3506 173.111C77.296 171.135 78.1253 170.805 85.9098 165.909C89.0059 163.965 89.9347 159.892 87.9665 156.829C86.0093 153.755 81.8849 152.811 78.822 154.776" fill="currentColor"/>
        </svg>
        {currentLabel && (
          <span id="header-label" class="header-label select-none text-xl font-medium">
            {currentLabel}
          </span>
        )}
      </button>

      <nav
        id="header-dropdown"
        class="header-dropdown absolute top-1/2 -translate-y-1/2 opacity-0 -translate-x-2 pointer-events-none transition-all duration-150 ease-out"
      >
        <ul class="flex items-center gap-6 text-xl">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'hover:text-gray-700 transition-colors',
                  isActive(link.href) ? 'text-gray-900 font-medium' : 'text-gray-500',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Scroll-linked collapse. `--t` (0 = expanded, 1 = compact) is written by
     watchHeaderCollapse on scroll; every collapsing value interpolates from it
     via calc(), so the shrink tracks the scrollbar instead of snapping. The
     default keeps the expanded state before/without JS (SSR). */
  #site-header {
    --t: 0;
  }

  /* Optical alignment: nudge the avatar + menu row slightly right so the
     round avatar reads as aligned with the body text column. */
  .header-content {
    margin-left: 2px;
  }

  .header-label {
    font-size: calc(1.25rem - var(--t) * 0.125rem);
    opacity: 1;
    transition: opacity 0.2s ease-out;
  }

  .header-label.menu-open {
    opacity: 0;
    pointer-events: none;
  }

  /* Align dropdown with the avatar column (avatar width + gap). */
  .header-dropdown {
    left: calc(2.875rem - var(--t) * 0.5rem);
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }

  #header-dropdown ul {
    font-size: calc(1.25rem - var(--t) * 0.125rem);
  }

  /* Expanded → compact header height.
     Expanded: 48 + 32 + 16 = 96px. Compact: 18 + 24 + 18 = 60px. */
  .header-inner {
    padding-top: calc(3rem - var(--t) * 1.875rem);
    padding-bottom: calc(1rem + var(--t) * 0.125rem);
  }

  #header-avatar {
    width: calc(2rem - var(--t) * 0.5rem);
    height: calc(2rem - var(--t) * 0.5rem);
    /* transform transition is for the menu-open rotate, not the scrub. */
    transition: transform 0.2s ease-out;
  }

  /* Keep the avatar ink in sync with the label's hover color transition. */
  #header-avatar path {
    transition: fill 0.15s ease;
  }
</style>

<script>
  import { watchHeaderCollapse } from '@/scripts/headerScroll';

  // Reset per page-load so listeners on persistent targets (document, window)
  // are torn down before we re-attach, instead of accumulating across soft
  // navigations.
  let controller: AbortController | null = null;

  function setupHeader() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.getElementById('site-header');
    const button = document.getElementById('header-menu-button');
    const dropdown = document.getElementById('header-dropdown');
    const avatar = document.getElementById('header-avatar');
    const label = document.getElementById('header-label');

    if (!header || !button || !dropdown || !avatar) return;

    watchHeaderCollapse(header, signal);

    // Single source of truth for collapsing the dropdown. `slide` controls
    // whether it eases back to the left (vs. fading in place); `restoreLabel`
    // controls whether the section label reappears next to the avatar.
    const collapseDropdown = ({ slide, restoreLabel }: { slide: boolean; restoreLabel: boolean }) => {
      dropdown.classList.remove('opacity-100');
      dropdown.classList.add('opacity-0', 'pointer-events-none');
      if (slide) {
        dropdown.classList.remove('translate-x-0');
        dropdown.classList.add('-translate-x-2');
      }
      avatar.classList.remove('rotate-[20deg]');
      if (restoreLabel) label?.classList.remove('menu-open');
      button.setAttribute('aria-expanded', 'false');
    };

    const openDropdown = () => {
      avatar.classList.add('rotate-[20deg]');
      label?.classList.add('menu-open');
      button.setAttribute('aria-expanded', 'true');
      setTimeout(() => {
        dropdown.classList.remove('opacity-0', '-translate-x-2', 'pointer-events-none');
        dropdown.classList.add('opacity-100', 'translate-x-0');
      }, 135);
    };

    // When a section label is showing (Work/Stack/Now), close with a fade in
    // place — same path as picking a nav item. About has no label, so it keeps
    // the slide-back close.
    const closeMenu = () => {
      const hasLabel = !!label;
      collapseDropdown({ slide: !hasLabel, restoreLabel: true });
    };

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      if (dropdown.classList.contains('opacity-100')) {
        closeMenu();
      } else {
        openDropdown();
      }
    }, { signal });

    document.addEventListener('click', () => {
      if (dropdown.classList.contains('opacity-100')) {
        closeMenu();
      }
    }, { signal });

    const isCurrentPage = (href: string) => {
      const path = window.location.pathname;
      if (href === '/') return path === '/';
      return path === href || path.startsWith(`${href}/`);
    };

    dropdown.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target?.tagName !== 'A') return;

      const href = (target as HTMLAnchorElement).getAttribute('href');
      if (!href) return;

      // Clicking the current section: cancel navigation and fade closed in
      // place, restoring the label.
      if (isCurrentPage(href)) {
        e.preventDefault();
        collapseDropdown({ slide: false, restoreLabel: true });
        return;
      }

      // Navigating to another page: fade out in place (no slide back) and keep
      // the old label suppressed until the new page header mounts.
      collapseDropdown({ slide: false, restoreLabel: false });
    }, { signal });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
