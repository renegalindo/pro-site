---
interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/stack', label: 'Stack' },
  { href: '/now', label: 'Now' },
];

const currentPath = Astro.url.pathname;

// Helper to check if a link matches current path
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));

// Label shown next to the avatar when the menu is collapsed.
// About (/) intentionally shows no label.
const activeLink = navLinks.find((link) => isActive(link.href));
const currentLabel = activeLink && activeLink.href !== '/' ? activeLink.label : null;
---

<header id="site-header" class:list={[
  "top-0 z-10 w-full bg-gray-50/70 backdrop-blur-md",
  hidden ? "absolute opacity-0 pointer-events-none" : "fixed"
]}>
  <div class="header-inner max-w-2xl mx-auto px-4">
    <div class="relative flex items-center">
      <button
        id="header-menu-button"
        type="button"
        class="header-trigger group flex items-center gap-4 text-gray-900 transition-colors hover:text-gray-600"
        aria-label={currentLabel ? `Open menu, current section ${currentLabel}` : 'Open menu'}
        aria-expanded="false"
        aria-controls="header-dropdown"
      >
        <img id="header-avatar" src="/avatar.png" alt="" class="w-10 h-10 shrink-0 rounded-full transition-all duration-200 ease-in-out" />
        {currentLabel && (
          <span id="header-label" class="header-label select-none text-xl font-medium">
            {currentLabel}
          </span>
        )}
      </button>

      <nav
        id="header-dropdown"
        class="header-dropdown absolute top-1/2 -translate-y-1/2 opacity-0 -translate-x-2 pointer-events-none transition-all duration-150 ease-out"
      >
        <ul class="flex items-center gap-6 text-xl">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'hover:text-gray-600 transition-colors',
                  isActive(link.href) ? 'text-gray-900 font-medium' : 'text-gray-500',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .header-label {
    opacity: 1;
    transition: opacity 0.2s ease-out, font-size 0.25s ease-out;
  }

  /* Align dropdown with the label column (avatar width + gap). */
  .header-dropdown {
    left: calc(2.5rem + 1rem);
    transition: left 0.25s ease-out, opacity 0.15s ease-out, transform 0.15s ease-out;
  }

  #site-header.scrolled .header-dropdown {
    left: calc(2rem + 1rem);
  }

  #site-header.scrolled .header-label {
    font-size: 1.125rem;
  }

  #header-dropdown ul {
    transition: font-size 0.25s ease-out;
  }

  #site-header.scrolled #header-dropdown ul {
    font-size: 1.125rem;
  }

  .header-label.menu-open {
    opacity: 0;
    pointer-events: none;
  }

  /* Expanded (top of page) → compact (scrolled) header.
     Expanded: 48 + 40 + 16 = 104px. Compact: 18 + 32 + 18 = 68px. */
  .header-inner {
    padding-top: 3rem;
    padding-bottom: 1rem;
    transition: padding 0.25s ease-out;
  }

  #site-header.scrolled .header-inner {
    padding-top: 1.125rem;
    padding-bottom: 1.125rem;
  }

  #site-header.scrolled #header-avatar {
    width: 2rem;
    height: 2rem;
  }
</style>

<script>
  let scrollHandler: (() => void) | null = null;

  function setupHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);

    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      // Latch: commit to compact as soon as we leave the top, and only
      // return to the tall state once we're back at the very top. This
      // deadband avoids flip-flopping (and mid-transition jitter) when
      // scrollY hovers around a single threshold.
      if (y > 44) {
        header.classList.add('scrolled');
      } else if (y < 36) {
        header.classList.remove('scrolled');
      }
      ticking = false;
    };

    scrollHandler = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', scrollHandler, { passive: true });
    update();
  }

  function setupHeader() {
    setupHeaderScroll();

    const button = document.getElementById('header-menu-button');
    const dropdown = document.getElementById('header-dropdown');
    const avatar = document.getElementById('header-avatar');
    const label = document.getElementById('header-label');

    if (!button || !dropdown || !avatar) return;

    const closeDropdown = () => {
      dropdown.classList.remove('opacity-100', 'translate-x-0');
      dropdown.classList.add('opacity-0', '-translate-x-2', 'pointer-events-none');
      avatar.classList.remove('rotate-[20deg]');
      label?.classList.remove('menu-open');
      button.setAttribute('aria-expanded', 'false');
    };

    const openDropdown = () => {
      avatar.classList.add('rotate-[20deg]');
      label?.classList.add('menu-open');
      button.setAttribute('aria-expanded', 'true');
      setTimeout(() => {
        dropdown.classList.remove('opacity-0', '-translate-x-2', 'pointer-events-none');
        dropdown.classList.add('opacity-100', 'translate-x-0');
      }, 135);
    };

    const toggleDropdown = (e: MouseEvent) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('opacity-100');
      isOpen ? closeDropdown() : openDropdown();
    };

    button.addEventListener('click', toggleDropdown);

    document.addEventListener('click', () => {
      if (dropdown.classList.contains('opacity-100')) {
        closeDropdown();
      }
    });

    dropdown.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target?.tagName === 'A') {
        // Navigating to another page: fade out in place (no slide back).
        // Keep the old label suppressed until the new page header mounts.
        dropdown.classList.remove('opacity-100');
        dropdown.classList.add('opacity-0', 'pointer-events-none');
        avatar.classList.remove('rotate-[20deg]');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
