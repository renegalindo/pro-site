<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" tabindex="-1">
  <div class="lightbox-backdrop"></div>
  <img class="lightbox-image" id="lightbox-image" alt="" />
  <div class="lightbox-counter" id="lightbox-counter" aria-live="polite"></div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem;
    /* Closed: unpainted and out of the a11y tree / tab order. The close morph is
       driven in JS and only removes `data-open` once it lands on the thumbnail,
       so visibility can flip instantly in both directions — no lingering delay
       (which used to leave the full-size image painted for a beat after close). */
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s;
  }

  .lightbox[data-open] {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }

  /* Separate backdrop element so it can fade independently of the image and
     controls (which stay fully opaque while the image morphs). */
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(249, 250, 251, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease-out;
    /* Default arrow (not zoom-out) on the dim: zoom-out belongs to the image —
       the thing that collapses back down. The surrounding area stays neutral;
       it still closes on click, but doesn't advertise itself as a control. */
    cursor: default;
  }
  .lightbox[data-open] .lightbox-backdrop {
    opacity: 1;
  }

  .lightbox-image {
    position: relative;
    max-width: min(64rem, 100vw - 3rem);
    max-height: calc(100vh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    cursor: zoom-out;
    box-shadow:
      0 0 0 1px rgba(10, 10, 10, 0.05),
      0 12px 40px -8px rgba(0, 0, 0, 0.22);
  }

  /* Single-image galleries have no counter. */
  .lightbox[data-single] .lightbox-counter {
    display: none;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: #6b7280;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-out 0.1s;
  }
  .lightbox[data-open] .lightbox-counter {
    opacity: 1;
  }

  /* During the close morph the overlay stays painted (so the image can animate)
     while the backdrop and chrome fade out. Declared here — after the
     `[data-open]` rules so it wins — instead of poking inline opacity from JS. */
  .lightbox[data-closing] .lightbox-backdrop,
  .lightbox[data-closing] .lightbox-counter {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .lightbox {
      padding: 2rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox-backdrop,
    .lightbox-counter {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // Morph timing. Duration scales with how far the image actually travels
  // (thumbnail centre → settled centre) so a corner thumbnail and a centred one
  // feel like the same gesture instead of the far one launching. Clamped between
  // a snappy floor and a ceiling; distance is mapped over DURATION_REF px.
  const MIN_DURATION = 280;
  const MAX_DURATION = 460;
  const DURATION_REF = 820;
  // Open: ease-in-out (cubic) — gentle acceleration out of the thumbnail, gentle
  // settle into place, so an edge image doesn't launch toward centre.
  const EASE_OPEN = 'cubic-bezier(0.65, 0, 0.35, 1)';
  // Close: ease-out (cubic) — leave centre promptly (no slow-start hang, which
  // would keep the travelling image parked over a neighbouring thumbnail) but
  // with a gentler initial velocity and a soft tail into the landing, so it
  // doesn't read as snappy. Same duration as the open.
  const EASE_CLOSE = 'cubic-bezier(0.33, 1, 0.68, 1)';
  const THUMB_RADIUS = '16px';
  const OPEN_RADIUS = '12px';

  const srcOf = (img: HTMLImageElement) => img.currentSrc || img.src;
  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setupLightbox() {
    const lightbox = document.getElementById('lightbox');
    const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const counter = document.getElementById('lightbox-counter');
    if (!lightbox || !image || !counter) return;

    // Tag article images as zoomable on every load (markdown can't add the
    // attribute itself). The `/now` snapshots already carry `[data-zoomable]`.
    document.querySelectorAll<HTMLImageElement>('.prose img:not([data-zoomable])').forEach((img) => {
      img.setAttribute('data-zoomable', '');
      img.setAttribute('role', 'button');
      img.setAttribute('tabindex', '0');
      if (!img.getAttribute('aria-label')) {
        img.setAttribute('aria-label', img.alt ? `Expand image: ${img.alt}` : 'Expand image');
      }
    });

    // Bind interaction listeners once — the lightbox persists across view
    // transitions, so its handlers must not stack up.
    if (lightbox.dataset.bound) return;
    lightbox.dataset.bound = 'true';

    let gallery: HTMLImageElement[] = [];
    let index = -1;
    let lastFocused: HTMLElement | null = null;
    let animating = false;
    // A close asked for mid-animation is queued here and run when the in-flight
    // morph/cross-fade settles — dropping it used to strand a hidden thumbnail.
    let pendingClose = false;
    // Whether this session was opened from the keyboard. Focus (and its visible
    // ring) is only returned to the trigger for keyboard opens; a pointer open
    // that returned focus would paint a keyboard focus ring on the thumbnail.
    let openedViaKeyboard = false;

    // Every `[data-zoomable]` maps to one image (itself, or the one it wraps),
    // collected in document order so navigation follows the page.
    const collectGallery = () =>
      Array.from(document.querySelectorAll('[data-zoomable]'))
        .map((t) => (t instanceof HTMLImageElement ? t : t.querySelector('img')))
        .filter((img): img is HTMLImageElement => !!img);

    const clearGeometry = () => {
      image.style.position = '';
      image.style.left = image.style.top = image.style.width = image.style.height = '';
      image.style.borderRadius = '';
      image.style.opacity = '';
    };

    // Animate the image between two on-screen rectangles by its geometry (not a
    // transform scale) so corners and shadow stay crisp throughout the morph.
    const morph = (from: DOMRect, to: DOMRect, r0: string, r1: string, easing: string) => {
      image.style.position = 'fixed';
      // Distance-proportional duration: map centre-to-centre travel onto
      // [MIN, MAX] so perceived velocity stays roughly constant across thumbnails.
      const dx = to.left + to.width / 2 - (from.left + from.width / 2);
      const dy = to.top + to.height / 2 - (from.top + from.height / 2);
      const t = Math.min(Math.hypot(dx, dy) / DURATION_REF, 1);
      const duration = MIN_DURATION + (MAX_DURATION - MIN_DURATION) * t;
      return image.animate(
        [
          { left: `${from.left}px`, top: `${from.top}px`, width: `${from.width}px`, height: `${from.height}px`, borderRadius: r0 },
          { left: `${to.left}px`, top: `${to.top}px`, width: `${to.width}px`, height: `${to.height}px`, borderRadius: r1 },
        ],
        { duration, easing, fill: 'both' },
      );
    };

    const updateChrome = () => {
      counter.textContent = `${index + 1} / ${gallery.length}`;
      lightbox.toggleAttribute('data-single', gallery.length <= 1);
    };

    const preloadNeighbors = () => {
      [index - 1, index + 1].forEach((i) => {
        const el = gallery[(i + gallery.length) % gallery.length];
        if (el) new Image().src = srcOf(el);
      });
    };

    // Thumbnails are hidden/revealed by opacity (not `visibility`) so navigation
    // can fade them instead of popping — during a swipe the outgoing thumbnail
    // reappears and the incoming one hides behind the backdrop, and an instant
    // toggle there reads as an abrupt flicker. `animate` opts into the fade via
    // an inline transition; the instant path (open/close/restore) clears that
    // inline transition so a thumbnail's own CSS transition (e.g. the /now
    // box-shadow) is left untouched at rest.
    const THUMB_FADE = 'opacity 200ms ease';
    const showThumb = (el: HTMLElement | null, animate = false) => {
      if (!el) return;
      el.style.transition = animate ? THUMB_FADE : '';
      el.style.opacity = '';
    };
    const hideThumb = (el: HTMLElement | null, animate = false) => {
      if (!el) return;
      el.style.transition = animate ? THUMB_FADE : '';
      el.style.opacity = '0';
    };
    // Un-hide every thumbnail. Re-resolves from the live DOM (not the cached
    // `gallery`) so it also covers page-transition / bfcache teardown, where the
    // collected list can reference a swapped-out document. Restoring all — rather
    // than only the last-hidden one — means an interrupted sequence can't orphan
    // a thumbnail in the hidden state.
    // Arrow wrapper (not point-free): `forEach` would otherwise pass the array
    // index as `showThumb`'s `animate` arg, re-applying the fade transition on
    // restore instead of clearing it.
    const restoreAllThumbs = () => collectGallery().forEach((el) => showThumb(el));
    const swapImage = (el: HTMLImageElement) => {
      image.src = srcOf(el);
      image.alt = el.alt;
    };

    // `gallery` is collected by the trigger handlers (which need it to resolve
    // the clicked index); `open` trusts that list rather than re-scanning.
    const open = (i: number) => {
      if (animating) return;
      if (i < 0 || i >= gallery.length) return;
      index = i;
      lastFocused = document.activeElement as HTMLElement;

      const thumb = gallery[index];
      const from = thumb.getBoundingClientRect();
      hideThumb(thumb);

      swapImage(thumb);
      document.documentElement.style.overflow = 'hidden';
      // Publish a page-level "a modal is open" flag so other components (e.g. the
      // article's Escape-to-go-back handler) can defer without knowing about this
      // component by id.
      document.documentElement.setAttribute('data-modal-open', '');
      updateChrome();
      lightbox.setAttribute('data-open', '');
      lightbox.focus();
      preloadNeighbors();

      if (prefersReduced()) return;

      // Hold the image invisible until we morph it in.
      image.style.opacity = '0';
      // Claim the animation slot before the (possibly async) decode below, so a
      // close arriving mid-open is queued via `pendingClose` rather than racing.
      animating = true;

      // Measure the settled (contained, centred) rect while invisible, then run
      // the morph from the thumbnail's rect up to it.
      const startMorph = () => {
        // Drop any lingering animation fill before measuring the target rect.
        image.getAnimations().forEach((a) => a.cancel());
        clearGeometry();
        image.style.opacity = '0';
        const to = image.getBoundingClientRect();
        image.style.opacity = '1';
        const anim = morph(from, to, THUMB_RADIUS, OPEN_RADIUS, EASE_OPEN);
        anim.onfinish = () => {
          // Cancel so `fill: both` stops overriding the settled layout, then
          // hand the image back to the centred flex flow.
          anim.cancel();
          clearGeometry();
          animating = false;
          runPendingClose();
        };
      };

      // Only measure `to` once the image has real pixels. The lightbox image is
      // `width:auto; object-fit:contain`, so its size comes entirely from the
      // image's intrinsic dimensions — an undecoded image (bitmap evicted while
      // the tab was backgrounded) lays out ~0×0, which made the open morph
      // collapse the thumbnail into a tiny centred dot instead of scaling it up.
      // Warm images measure right away; cold ones wait for decode first.
      const ready = image.complete && image.naturalWidth > 0
        ? Promise.resolve()
        : image.decode().catch(() => {});
      ready.then(() => requestAnimationFrame(startMorph));
    };

    const close = () => {
      if (!lightbox.hasAttribute('data-open')) return;
      // Don't drop a close mid-animation — queue it. The open morph and the
      // nav cross-fade both run it from their onfinish once they settle.
      if (animating) { pendingClose = true; return; }
      const thumb = gallery[index];

      const finish = () => {
        pendingClose = false;
        lightbox.removeAttribute('data-open');
        lightbox.removeAttribute('data-closing');
        document.documentElement.style.overflow = '';
        document.documentElement.removeAttribute('data-modal-open');
        restoreAllThumbs();
        clearGeometry();
        // Return focus to the trigger only for keyboard opens (where the focus
        // ring is wanted). For pointer opens, drop focus so no keyboard ring is
        // painted on the thumbnail after Escape/click close.
        if (openedViaKeyboard) lastFocused?.focus();
        else (lastFocused as HTMLElement | null)?.blur?.();
      };

      if (prefersReduced() || !thumb) {
        finish();
        return;
      }

      // Only scroll when the thumbnail is mostly out of view (e.g. navigation
      // moved it far off-screen), so the image has a visible anchor to morph
      // back into. A thumbnail that's merely clipped at an edge — the one you
      // opened and could still see — closes in place, leaving scroll untouched.
      let to = thumb.getBoundingClientRect();
      const visible = Math.max(0, Math.min(to.bottom, window.innerHeight) - Math.max(to.top, 0));
      if (to.height > 0 && visible / to.height < 0.6) {
        thumb.scrollIntoView({ block: 'center' });
        to = thumb.getBoundingClientRect();
      }
      const from = image.getBoundingClientRect();

      // Backdrop + chrome fade out via CSS; the image stays opaque and morphs.
      lightbox.setAttribute('data-closing', '');

      animating = true;
      const anim = morph(from, to, OPEN_RADIUS, THUMB_RADIUS, EASE_CLOSE);
      anim.onfinish = () => {
        anim.cancel();
        animating = false;
        finish();
      };
    };

    // Run a close that arrived mid-animation, now that the animation has settled.
    // `close` proceeds (animating is already cleared) and `finish` resets the flag.
    const runPendingClose = () => { if (pendingClose) close(); };

    const go = (dir: number) => {
      if (animating || gallery.length <= 1) return;
      const prevThumb = gallery[index];
      index = (index + dir + gallery.length) % gallery.length;
      const nextThumb = gallery[index];
      // Fade the underlying thumbnails as they swap roles (instant in reduced
      // motion). open/close/restore keep the instant, non-animated path.
      const fade = !prefersReduced();
      showThumb(prevThumb, fade);
      hideThumb(nextThumb, fade);
      updateChrome();
      preloadNeighbors();

      if (prefersReduced()) {
        swapImage(nextThumb);
        return;
      }

      // Light directional cross-fade between images (distinct from the open
      // morph). Fade the current out toward the travel direction, swap, fade in.
      // Single <img>, so this is a quick dip: a brisk exit reaches the swap fast
      // (short empty beat) and a softer, longer entrance lets the next settle.
      const SLIDE = 16;
      const out = image.animate(
        [
          { opacity: 1, transform: 'translateX(0)' },
          { opacity: 0, transform: `translateX(${-dir * SLIDE}px)` },
        ],
        { duration: 160, easing: 'ease-in', fill: 'forwards' },
      );
      animating = true;
      out.onfinish = () => {
        out.cancel();
        swapImage(nextThumb);
        const inn = image.animate(
          [
            { opacity: 0, transform: `translateX(${dir * SLIDE}px)` },
            { opacity: 1, transform: 'translateX(0)' },
          ],
          { duration: 240, easing: 'ease-out', fill: 'forwards' },
        );
        inn.onfinish = () => {
          inn.cancel();
          image.style.transform = '';
          image.style.opacity = '';
          animating = false;
          runPendingClose();
        };
      };
    };

    // Resolve a trigger's image to its gallery index and open — collecting the
    // gallery once (the resolved list is what `open` then works from). Records
    // how it was opened so close can decide whether to return the focus ring.
    const openFromTrigger = (img: HTMLImageElement, viaKeyboard: boolean) => {
      openedViaKeyboard = viaKeyboard;
      gallery = collectGallery();
      open(gallery.indexOf(img));
    };

    // Open: click or keyboard-activate any zoomable trigger.
    document.addEventListener('click', (e) => {
      if (lightbox.hasAttribute('data-open')) return;
      const trigger = (e.target as HTMLElement).closest('[data-zoomable]');
      if (!trigger) return;
      const img = trigger instanceof HTMLImageElement ? trigger : trigger.querySelector('img');
      if (!img) return;
      e.preventDefault();
      openFromTrigger(img as HTMLImageElement, false);
    });

    document.addEventListener('keydown', (e) => {
      const active = document.activeElement as HTMLElement | null;
      if (!lightbox.hasAttribute('data-open') && active?.matches('[data-zoomable]') && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        openFromTrigger(active as HTMLImageElement, true);
      }
    });

    // Click anywhere in the overlay (backdrop or the image) closes it.
    lightbox.addEventListener('click', () => {
      close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.hasAttribute('data-open')) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    }, { capture: true });

    // Touch: horizontal swipe navigates, a downward swipe closes.
    let tx = 0, ty = 0;
    lightbox.addEventListener('touchstart', (e) => {
      tx = e.changedTouches[0].clientX; ty = e.changedTouches[0].clientY;
    }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - tx;
      const dy = e.changedTouches[0].clientY - ty;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
      else if (dy > 70) close();
    }, { passive: true });

    // Safety net: if the page transitions away (Astro view transitions) or is
    // frozen into bfcache while the overlay is open, un-hide every thumbnail so
    // a restored snapshot never shows a gap where a hidden image used to be.
    document.addEventListener('astro:before-preparation', restoreAllThumbs);
    window.addEventListener('pagehide', restoreAllThumbs);
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
