---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { snapshotDateline } from '@/lib/snapshots';

interface Props {
  entry: CollectionEntry<'now'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const dateline = snapshotDateline(entry.data.date, entry.data.location);
const { image, imageAlt } = entry.data;
---

<div class="space-y-6 text-gray-900 leading-relaxed">
  <p>{dateline}</p>
  <div class="snapshot-prose">
    <Content />
  </div>
  {image && (
    <figure class="snapshot-figure">
      <button type="button" class="zoomable" data-zoomable aria-label={imageAlt ? `Expand image: ${imageAlt}` : 'Expand image'}>
        <Image src={image} alt={imageAlt ?? ''} width={961} class="snapshot-image" />
      </button>
    </figure>
  )}
</div>

<style>
  .snapshot-prose :global(p) {
    margin-top: 1.5rem;
  }
  .snapshot-prose :global(p:first-child) {
    margin-top: 0;
  }
  .snapshot-prose :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .snapshot-prose :global(li) {
    margin-top: 0.5rem;
  }
  .snapshot-prose :global(li:first-child) {
    margin-top: 0;
  }

  .snapshot-figure {
    margin: 0;
    max-width: 22rem;
  }

  .zoomable {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 0.75rem;
    -webkit-tap-highlight-color: transparent;
  }

  .zoomable :global(.snapshot-image) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px rgba(10, 10, 10, 0.05),
      0 4px 12px -2px rgba(0, 0, 0, 0.06),
      0 2px 4px -2px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.25s ease;
  }

  .zoomable:hover :global(.snapshot-image),
  .zoomable:focus-visible :global(.snapshot-image) {
    box-shadow:
      0 0 0 1px rgba(10, 10, 10, 0.065),
      0 14px 32px -8px rgba(0, 0, 0, 0.17),
      0 5px 11px -5px rgba(0, 0, 0, 0.11);
  }

  .zoomable:focus-visible {
    outline: 2px solid #6b7280;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .zoomable :global(.snapshot-image) {
      transition: none;
    }
  }
</style>
