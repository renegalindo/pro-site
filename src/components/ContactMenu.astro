---
// Inline "hello" trigger that opens a small contact menu (mirrors the
// now-page rail's card styling). Lives inside a <p>, so every element here is
// phrasing content — spans/anchors/buttons, never block-level — to keep the
// paragraph valid.
//
// Style/script come first and the markup is the last thing in the file so the
// component's rendered output ends exactly at </span>: no trailing whitespace
// node between the trigger and the sentence's period.
const email = 'mail@renegalindo.com';
const linkedin = 'https://www.linkedin.com/in/renegalindo/';
const threads = 'https://www.threads.com/@lospiesderene';
---
<style>
  .contact {
    position: relative;
    display: inline-block;
  }

  /* Match the site's minimal inline-link look (see BaseLayout `main a`). */
  .contact-trigger {
    font: inherit;
    color: inherit;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: underline dotted;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .contact-trigger:hover,
  .contact-trigger:focus-visible,
  .contact[data-open] .contact-trigger {
    outline: none;
    color: #6b7280;
    text-decoration-color: #6b7280;
  }

  /* Left-aligned under the trigger (down-right dropdown). On narrow screens the
     trigger sits near the right edge, so the menu flips to right-aligned
     (down-left) below — see the mobile media query — to stay on-screen. */
  .contact-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: auto;
    margin-top: 0.5rem;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transform-origin: top left;
    pointer-events: none;
    /* Keep the menu untabbable while hidden, then flip instantly on open. */
    transition: opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0s linear 0.15s;
  }

  .contact[data-open] .contact-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition: opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0s;
  }

  .contact-card {
    display: block;
    min-width: 14rem;
    max-width: min(20rem, calc(100vw - 2rem));
    padding: 0.375rem;
    border-radius: 0.5rem;
    background: #ffffff;
    box-shadow:
      0 0 0 1px rgba(10, 10, 10, 0.05),
      0 8px 24px -6px rgba(0, 0, 0, 0.12),
      0 2px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.375rem 0.5rem;
    border: 0;
    border-radius: 0.375rem;
    background: none;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: #374151;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .contact-item + .contact-item {
    margin-top: 1px;
  }

  .contact-item:hover,
  .contact-item:focus-visible {
    outline: none;
    background: #f5f5f5;
    color: #0a0a0a;
  }

  /* Leading app icon (favicon image, or the Lucide mail glyph for email). */
  .contact-lead {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  /* Favicons: flat rounded tiles, no shadow or ring. */
  .contact-favicon {
    border-radius: 0.375rem;
    object-fit: cover;
  }

  /* The email row's leading slot stacks three glyphs (mail / copy / check) on
     top of each other, cross-fading via opacity so the label never shifts. */
  .contact-lead-stack {
    position: relative;
  }

  .contact-lead-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .contact-mail {
    color: #9ca3af;
    opacity: 1;
  }

  .contact-label {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Icons stay hidden until the row is hovered/focused; opacity (not display)
     keeps their slot reserved so the labels never shift. */
  .contact-icon {
    flex-shrink: 0;
    color: #d1d5db;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .contact-item:hover .contact-icon,
  .contact-item:focus-visible .contact-icon {
    opacity: 1;
    color: #9ca3af;
  }

  /* Hover: mail fades out, copy glyph fades in, in the same leading slot. */
  .contact-copy:hover .contact-mail,
  .contact-copy:focus-visible .contact-mail {
    opacity: 0;
  }

  .copy-icon {
    color: #9ca3af;
  }

  .contact-copy:hover .copy-icon,
  .contact-copy:focus-visible .copy-icon {
    opacity: 1;
  }

  /* Copied: check glyph wins regardless of hover — placed last so equal-
     specificity rules above lose the tie. */
  .check-icon {
    color: #16a34a;
  }

  .contact-copy[data-copied] .contact-mail,
  .contact-copy[data-copied] .copy-icon {
    opacity: 0;
  }

  .contact-copy[data-copied] .check-icon {
    opacity: 1;
  }

  /* Narrow screens: "hello" sits near the right edge, so open down-left. */
  @media (max-width: 639.98px) {
    .contact-menu {
      right: 0;
      left: auto;
      transform-origin: top right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-trigger,
    .contact-menu {
      transition: none;
    }
    .contact[data-open] .contact-menu {
      transform: none;
    }
  }
</style>
<script>
  // Reset per page-load so listeners tear down before we re-attach, instead of
  // accumulating across soft navigations.
  let controller: AbortController | null = null;

  function setupContact() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>('[data-contact]');
    if (!root) return;
    const trigger = root.querySelector<HTMLButtonElement>('.contact-trigger');
    const links = root.querySelectorAll<HTMLAnchorElement>('a.contact-item');
    const copyBtn = root.querySelector<HTMLButtonElement>('.contact-copy');
    if (!trigger) return;

    const open = () => {
      root.setAttribute('data-open', '');
      trigger.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      root.removeAttribute('data-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      root.hasAttribute('data-open') ? close() : open();
    }, { signal });

    // Outside click and Escape close the menu.
    document.addEventListener('click', (e) => {
      if (root.hasAttribute('data-open') && !root.contains(e.target as Node)) close();
    }, { signal });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !root.hasAttribute('data-open')) return;
      e.preventDefault();
      close();
      trigger.focus();
    }, { signal });

    // Opening an external link (new tab) closes the menu so it isn't left hanging.
    links.forEach((link) => link.addEventListener('click', () => close(), { signal }));

    // Email copies to the clipboard instead of opening a mail client. Feedback
    // is the leading icon swapping to a check and the label reading "Copied!";
    // the menu stays open, then both revert.
    if (copyBtn) {
      const label = copyBtn.querySelector<HTMLElement>('[data-copy-label]');
      const emailText = label?.textContent ?? '';
      let revertTimer: number | undefined;

      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email ?? '');
        } catch {
          return; // Clipboard unavailable (e.g. insecure context) — do nothing.
        }
        copyBtn.setAttribute('data-copied', '');
        if (label) label.textContent = 'Copied!';
        window.clearTimeout(revertTimer);
        revertTimer = window.setTimeout(() => {
          copyBtn.removeAttribute('data-copied');
          if (label) label.textContent = emailText;
        }, 1600);
      }, { signal });

      signal.addEventListener('abort', () => window.clearTimeout(revertTimer));
    }
  }

  document.addEventListener('astro:page-load', setupContact);
</script>
<span class="contact" data-contact><button
    type="button"
    class="contact-trigger"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="contact-menu"
  >hello</button><span class="contact-menu" id="contact-menu"><span class="contact-card"><button
        type="button"
        class="contact-item contact-copy"
        data-email={email}
        aria-label={`Copy email address ${email}`}
      ><span class="contact-lead contact-lead-stack"><svg class="contact-lead-icon contact-mail" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg><svg class="contact-lead-icon copy-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg><svg class="contact-lead-icon check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg></span><span class="contact-label" data-copy-label>{email}</span></button><a
        class="contact-item"
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
      ><img class="contact-lead contact-favicon" src="/app-icons/linkedin.svg" alt="" width="20" height="20" decoding="async" loading="lazy" /><span class="contact-label">LinkedIn</span><svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></a><a
        class="contact-item"
        href={threads}
        target="_blank"
        rel="noopener noreferrer"
      ><img class="contact-lead contact-favicon" src="/app-icons/threads.svg" alt="" width="20" height="20" decoding="async" loading="lazy" /><span class="contact-label">Threads</span><svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></a></span></span></span>
