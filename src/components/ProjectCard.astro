---
import AppIconLabel from '@/components/AppIconLabel.astro';

interface Props {
  title: string;
  year?: string;
  logo?: string;
  /** Resolved destination for the row. The caller decides where it points
      (the deck slide in presentation mode, or the product's external URL);
      this component just renders it. Omit for a plain, non-navigating label. */
  href?: string;
  /** External links open in a new tab; internal deck links stay in-tab so the
      client router runs the drawer transition. Ignored when there's no href. */
  external?: boolean;
  /** Internal /work/<slug> destination for an unpublished card. Emitted as a
      `data-preview-href` hook so the preview script (see BaseLayout) can swap
      the row's outbound link for its in-progress detail page when preview mode
      is on. Omitted for published cards, which already link internally. */
  previewHref?: string;
}

const { title, year, logo, href, external = false, previewHref } = Astro.props;

const period = year?.replace(/-20/, '-');
// Without a destination the title is plain text (no dead link).
const isLinked = !!href;
// Hover/focus affordances only make sense when the row navigates, so the
// `group` (and every `group-hover:` / `group-focus-visible:` style) is gated on
// the same condition.
const interactive = isLinked ? 'group ' : '';
const Tag = isLinked ? 'a' : 'div';
// Only external links open a new tab (and need the rel guard); internal deck
// links stay in-tab so the client router runs the drawer transition.
const opensInNewTab = isLinked && external;
---

<li class="relative flex items-baseline pl-7">
  <Tag
    href={href}
    target={opensInNewTab ? '_blank' : undefined}
    rel={opensInNewTab ? 'noopener noreferrer' : undefined}
    data-preview-href={previewHref}
    class={`${interactive}block w-fit rounded-sm no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300`}
  >
    <AppIconLabel icon={logo} label={title} />
  </Tag>
  {period && (
    <Fragment>
      <span aria-hidden="true" class="mx-3 flex-1 border-b border-dashed border-gray-300"></span>
      {/* Fixed width = the widest period ("2024-25", ~65px at this size) so the
          dashed leaders all terminate at the same x. Sized to current content;
          a longer value than ~8 chars would need this bumped. */}
      <span class="w-[66px] shrink-0 text-right text-base text-gray-500 tabular-nums">{period}</span>
    </Fragment>
  )}
</li>
