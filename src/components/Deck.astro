---
// The portfolio deck: one continuous, client-controlled surface that shows one
// slide at a time. It is rendered whole on every route (all sections in the
// DOM) so that moving between projects is a client-side pushState — never a
// document reload — which keeps browser fullscreen alive across the whole deck.
//
// Sections = the intro (at `/portfolio`) followed by one per project (at
// `/portfolio/<slug>`). The URL names the *section*, never the slide: stepping
// within a section changes nothing; crossing into another section pushes its
// URL. `initialSection` decides which section this route boots on.
//
// The right-side nav is a Notion-style table of contents of sections (intro
// included): bars at rest, expanding to a labeled list on hover.
import Slide from '@/components/Slide.astro';
import type { Project } from '@/lib/portfolio';

interface Props {
  projects: Project[];
  initialSection: number;
}

const { projects, initialSection } = Astro.props;

// First slide index of each section (a TOC click lands on its first slide).
const sectionStarts: number[] = [];
let acc = 0;
for (const p of projects) {
  sectionStarts.push(acc);
  acc += p.slides.length;
}

// Flatten to one slide sequence; each slide knows its section so the TOC and
// counter can track the current one.
const slides = projects.flatMap((p, pi) =>
  p.slides.map((slide) => ({ slide, section: pi }))
);

const hrefFor = (p: Project) => (p.slug ? `/portfolio/${p.slug}` : '/portfolio');

// SSR the initial state so the right slide/section paints before JS boots (and
// as a no-JS fallback for a shared deep link). Every route boots on its
// section's first slide, so the counter always starts at 1.
const initialIndex = sectionStarts[initialSection] ?? 0;
const initialCount = projects[initialSection]?.slides.length ?? 0;
---

<div class="deck" id="deck" data-initial={initialIndex} tabindex="-1" transition:name="deck">
  <!-- Table of contents (sections), right — bars at rest, labels on hover.
       Deliberately NOT .deck-chrome: it stays visible while presenting in
       fullscreen as a subtle position cue; only the bottom controls fade. -->
  <nav class="deck-toc" aria-label="Sections">
    <div class="deck-toc-bars" aria-hidden="true">
      {projects.map((_, i) => (
        <span class:list={['deck-toc-bar', i === initialSection && 'is-active']}></span>
      ))}
    </div>
    <ul class="deck-toc-list">
      {projects.map((p, i) => (
        <li>
          <button
            class:list={['deck-toc-link', i === initialSection && 'is-active']}
            type="button"
            data-goto={sectionStarts[i]}
            data-href={hrefFor(p)}
          >{p.title}</button>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Slide stage -->
  <div class="deck-stage" data-stage>
    {slides.map((s, i) => (
      <section
        class:list={['deck-slide', i === initialIndex && 'is-active']}
        data-section={s.section}
      >
        <div class="deck-slide-inner">
          <Slide slide={s.slide} />
        </div>
      </section>
    ))}
  </div>

  <!-- Slide controls (bottom-center) -->
  <div class="deck-controls deck-chrome">
    <button class="deck-btn" type="button" data-prev aria-label="Previous slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <span class="deck-counter" data-counter>1 / {initialCount}</span>
    <button class="deck-btn" type="button" data-next aria-label="Next slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <span class="deck-controls-sep" aria-hidden="true"></span>
    <button class="deck-btn" type="button" data-fullscreen aria-label="Toggle fullscreen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
    </button>
    <a class="deck-btn" href="/work" data-exit aria-label="Exit portfolio">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </a>
  </div>
</div>

<style>
  /* The deck is a fixed full-viewport surface, so it escapes BaseLayout's
     constrained <main> and fills the screen. */
  .deck {
    position: fixed;
    inset: 0;
    background: #fafafa;
    color: #0a0a0a;
    z-index: 40;
  }
  /* The deck is focusable (tabindex=-1) only so keyboard focus can rest on a
     neutral surface while presenting — never show a ring on it. */
  .deck:focus,
  .deck:focus-visible {
    outline: none;
  }

  /* Entering the deck feels like a mode rising over the site. Runs once on
     load; a client-side section change never reinserts .deck, so it never
     replays. (Exit is handled by a View Transition — see the is:global block.) */
  @keyframes deck-enter {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .deck {
    animation: deck-enter 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* --- Slide stage --- */
  .deck-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4.5rem 6rem 6rem;
  }

  .deck-slide {
    position: absolute;
    inset: 4.5rem 6rem 6rem;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }
  .deck-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .deck-slide-inner {
    width: 100%;
    max-width: 52rem;
    max-height: 100%;
    overflow-y: auto;
  }

  /* --- Slide controls, bottom-center --- */
  .deck-controls {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.15);
    z-index: 10;
  }
  .deck-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    color: #4b5563;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .deck-btn:hover {
    background: #f0f0f0;
    color: #0a0a0a;
  }
  .deck-btn:disabled {
    color: #d1d5db;
    cursor: default;
    background: none;
  }
  .deck-counter {
    font-size: 0.8125rem;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
    padding: 0 0.5rem;
    min-width: 3.5rem;
    text-align: center;
  }
  .deck-controls-sep {
    width: 1px;
    height: 1.25rem;
    background: #e5e7eb;
    margin: 0 0.25rem;
  }

  /* --- Table of contents (Notion-style: bars at rest, list on hover) --- */
  .deck-toc {
    position: absolute;
    top: 50%;
    right: 1.75rem;
    transform: translateY(-50%);
    z-index: 10;
  }
  /* Resting bars — one per section, right-aligned. */
  .deck-toc-bars {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    transition: opacity 0.15s ease;
  }
  .deck-toc-bar {
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: #d1d5db;
    transition: width 0.16s ease, background 0.16s ease;
  }
  .deck-toc-bar.is-active {
    width: 24px;
    background: #0a0a0a;
  }
  /* Hover panel — the labeled list, anchored to the same right edge. */
  .deck-toc-list {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    min-width: 11rem;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    padding: 0.5rem;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 0.625rem;
    /* Shared popover-card elevation (matches SectionRail .rail-card and
       ContactMenu .contact-card) so floating surfaces read as one system. */
    box-shadow: 0 0 0 1px rgb(10 10 10 / 0.05), 0 8px 24px -6px rgb(0 0 0 / 0.12), 0 2px 6px -2px rgb(0 0 0 / 0.05);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .deck-toc:hover .deck-toc-bars {
    opacity: 0;
  }
  .deck-toc:hover .deck-toc-list {
    opacity: 1;
    pointer-events: auto;
  }
  .deck-toc-link {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: #6b7280;
    white-space: nowrap;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .deck-toc-link:hover {
    background: #f5f5f5;
    color: #0a0a0a;
  }
  .deck-toc-link.is-active {
    color: #0a0a0a;
    font-weight: 500;
  }

  /* --- Presentation focus (fullscreen only) --- */
  /* While presenting in fullscreen, arrow navigation softly hides the chrome
     (toc + controls); any mouse move brings it back. Windowed, this class is
     never applied, so everything stays visible. The cursor is never hidden. */
  .deck-chrome {
    transition: opacity 0.45s ease;
  }
  .deck.is-focused .deck-chrome {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 639.98px) {
    .deck-stage,
    .deck-slide {
      inset: 4rem 1.25rem 5rem;
      padding: 0;
    }
    .deck-toc { right: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck { animation: none; }
    .deck-slide { transition: none; }
    .deck-chrome { transition: none; }
  }
</style>

<!-- The deck's exit/entry view-transition rules (::view-transition-*(deck))
     live in src/styles/page-transitions.css (imported by BaseLayout), NOT
     here — see that file for why. -->

<script>
  import { navigate } from 'astro:transitions/client';
  import { suppressNextReveal } from '@/lib/transitions';

  function initDeck() {
    const deck = document.getElementById('deck');
    if (!deck) return;

    const slides = Array.from(deck.querySelectorAll<HTMLElement>('.deck-slide'));
    if (!slides.length) return;
    const tocBars = Array.from(deck.querySelectorAll<HTMLElement>('.deck-toc-bar'));
    const tocLinks = Array.from(deck.querySelectorAll<HTMLElement>('.deck-toc-link'));
    const counter = deck.querySelector<HTMLElement>('[data-counter]');
    const prevBtn = deck.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = deck.querySelector<HTMLButtonElement>('[data-next]');
    const fsBtn = deck.querySelector<HTMLButtonElement>('[data-fullscreen]');
    const exitLink = deck.querySelector<HTMLAnchorElement>('[data-exit]');

    // One controller tears down every listener together on navigation away
    // (the AbortController convention used across the site — see SectionRail,
    // ContactMenu, headerScroll).
    const controller = new AbortController();
    const { signal } = controller;

    const total = slides.length;

    // Section metadata, built from the DOM in one pass: which section each
    // slide belongs to, each section's slide elements/start index/size, and
    // its route.
    const sectionOf = slides.map((s) => Number(s.dataset.section));
    const sectionHref = tocLinks.map((l) => l.dataset.href || '/portfolio');
    const sectionSlides: HTMLElement[][] = [];
    const sectionStart: number[] = [];
    slides.forEach((s, i) => {
      const sec = sectionOf[i];
      if (!sectionSlides[sec]) {
        sectionSlides[sec] = [];
        sectionStart[sec] = i;
      }
      sectionSlides[sec].push(s);
    });

    let index = Number(deck.dataset.initial) || 0;
    let prevIndex = -1;
    let prevSection = -1;

    // --- Windowed media loading: only the current section ± 1 ever fetch. ---
    function loadSection(sec: number) {
      sectionSlides[sec]?.forEach((s) => {
        s.querySelectorAll<HTMLImageElement>('img[data-media-img]').forEach((img) => {
          if (!img.dataset.src || img.src) return;
          img.src = img.dataset.src;
          // Flip to the portrait layout once the image reports its natural size
          // (default renders landscape). Video/YouTube stay 16:9.
          img.addEventListener('load', () => {
            if (img.naturalHeight > img.naturalWidth) {
              img.closest<HTMLElement>('.slide')?.setAttribute('data-orientation', 'portrait');
            }
          }, { once: true });
        });
      });
    }
    function loadWindow(sec: number) {
      loadSection(sec - 1);
      loadSection(sec);
      loadSection(sec + 1);
    }

    // Paint the current index/section, touching only what actually changed
    // (the previous and new active slide/toc entry) rather than rescanning
    // every slide and toc item on every navigation.
    function render(sec: number) {
      if (prevIndex >= 0) slides[prevIndex].classList.remove('is-active');
      slides[index].classList.add('is-active');
      if (sec !== prevSection) {
        if (prevSection >= 0) {
          tocBars[prevSection]?.classList.remove('is-active');
          tocLinks[prevSection]?.classList.remove('is-active');
        }
        tocBars[sec]?.classList.add('is-active');
        tocLinks[sec]?.classList.add('is-active');
      }
      if (counter) counter.textContent = `${index - sectionStart[sec] + 1} / ${sectionSlides[sec].length}`;
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === total - 1;
      prevIndex = index;
      prevSection = sec;
    }

    // Move to a slide. Crossing into another section loads its media window and
    // (unless we're replaying history) pushes that section's URL — the only
    // time the address bar changes.
    function show(next: number, push = true) {
      index = Math.max(0, Math.min(total - 1, next));
      const sec = sectionOf[index];
      const fromSection = prevSection;
      render(sec);
      if (sec !== fromSection) {
        loadWindow(sec);
        if (push) history.pushState({ sec }, '', sectionHref[sec]);
      }
    }

    // Boot: paint initial state and prime the window around it (no push — the
    // URL is already correct for this route).
    show(index, false);

    // --- Navigation ---
    prevBtn?.addEventListener('click', () => show(index - 1), { signal });
    nextBtn?.addEventListener('click', () => show(index + 1), { signal });
    tocLinks.forEach((l) =>
      l.addEventListener('click', () => show(Number(l.dataset.goto)), { signal })
    );

    // Browser back/forward: the URL names a section → jump to its first slide
    // without pushing again.
    window.addEventListener('popstate', () => {
      const path = location.pathname.replace(/\/$/, '') || '/portfolio';
      const sec = sectionHref.findIndex((h) => (h.replace(/\/$/, '') || '/portfolio') === path);
      if (sec >= 0) show(sectionStart[sec], false);
    }, { signal });

    // --- Presentation focus (fullscreen only) ---
    // Moving focus to the deck as the chrome hides keeps focus off the buttons
    // (which are about to become invisible) so no focus ring lingers on them —
    // notably the fullscreen button after you've clicked it.
    const hideChrome = () => {
      deck.classList.add('is-focused');
      deck.focus({ preventScroll: true });
    };
    const showChrome = () => deck.classList.remove('is-focused');
    // Any pointer movement brings the chrome back. Guarded so it touches the
    // DOM only when chrome is hidden.
    deck.addEventListener('mousemove', () => {
      if (deck.classList.contains('is-focused')) showChrome();
    }, { signal });
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) showChrome();
    }, { signal });
    const focusOnNav = () => { if (document.fullscreenElement) hideChrome(); };

    // Leave for /work by dropping the deck away to reveal it — a client-side
    // navigation (no reload). The deck's `transition:name="deck"` (set
    // declaratively in the markup, not via JS — Astro's router resets ad-hoc
    // inline view-transition-names set right before navigate()) scopes the
    // drop-down animation to this element; suppressNextReveal() tells /work
    // not to replay its entry reveal, so it reads as if it were always there.
    function exitDeck() {
      const href = exitLink?.getAttribute('href') ?? '/work';
      suppressNextReveal();
      navigate(href);
    }

    // --- Keyboard ---
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
        e.preventDefault();
        show(index + 1);
        focusOnNav();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        show(index - 1);
        focusOnNav();
      } else if (e.key === 'Escape') {
        // Back out one level: leave fullscreen, else exit the deck (→ /work).
        if (document.fullscreenElement) document.exitFullscreen();
        else exitDeck();
      }
    }, { signal });

    // --- Click stage to advance (ignoring media, links, buttons) ---
    deck.querySelector('[data-stage]')?.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a, button, figure, iframe, video')) return;
      show(index + 1);
    }, { signal });

    // --- Swipe ---
    let startX = 0;
    deck.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true, signal });
    deck.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true, signal });

    // --- Fullscreen (present mode for interviews) ---
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else deck.requestFullscreen?.();
      // Don't leave focus (and a focus ring) parked on the button afterward.
      fsBtn.blur();
    }, { signal });

    // --- Exit link: animate out instead of an instant jump ---
    exitLink?.addEventListener('click', (e) => {
      e.preventDefault();
      exitDeck();
    }, { signal });

    // Tear every listener down together on navigation away.
    document.addEventListener('astro:before-preparation', () => controller.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initDeck);
</script>
